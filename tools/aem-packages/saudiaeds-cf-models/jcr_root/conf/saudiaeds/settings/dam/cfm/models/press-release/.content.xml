<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[^/content/dam/saudiaeds(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/saudiaeds/settings/dam/cfm/models/press-release/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="A Saudia press release (About us › press releases)."
        jcr:primaryType="cq:PageContent"
        jcr:title="Press Release"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <model
            cq:targetPath="/content/entities"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            jcr:primaryType="cq:PageContent"
            maxGeneratedOrder="20"
            sling:resourceType="wcm/scaffolding/components/scaffolding">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <title
                            jcr:primaryType="nt:unstructured"
                            listOrder="1"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="title"
                            fieldLabel="Title"
                            required="on"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                        <subtitle
                            jcr:primaryType="nt:unstructured"
                            listOrder="2"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="subtitle"
                            fieldLabel="Subtitle"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                        <location
                            jcr:primaryType="nt:unstructured"
                            listOrder="3"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="location"
                            fieldLabel="Location"
                            fieldDescription='Dateline city, e.g. "Jeddah".'
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                        <date
                            jcr:primaryType="nt:unstructured"
                            listOrder="4"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="date"
                            fieldLabel="Release date"
                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                            metaType="date"
                            valueType="calendar/date"
                            type="date"
                            displayedFormat="YYYY-MM-DD"/>
                        <layout
                            jcr:primaryType="nt:unstructured"
                            listOrder="5"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="layout"
                            fieldLabel="Layout"
                            fieldDescription="article: split lead (meta line, title, subtitle beside the image); legacy: campaign banner above the title."
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            metaType="enumeration"
                            valueType="string"
                            options="[article,legacy]"
                            emptyOption="true"/>
                        <heroImage
                            jcr:primaryType="nt:unstructured"
                            listOrder="6"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="heroImage"
                            fieldLabel="Lead image"
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/dam/saudiaeds"
                            showThumbnail="true"
                            validation="cfm.validation.contenttype.image"/>
                        <heroImageMobile
                            jcr:primaryType="nt:unstructured"
                            listOrder="7"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="heroImageMobile"
                            fieldLabel="Lead image (mobile)"
                            fieldDescription="Optional mobile rendition of the lead or banner image."
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/dam/saudiaeds"
                            showThumbnail="true"
                            validation="cfm.validation.contenttype.image"/>
                        <heroImageAlt
                            jcr:primaryType="nt:unstructured"
                            listOrder="8"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="heroImageAlt"
                            fieldLabel="Lead image alt text"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="500"/>
                        <body
                            jcr:primaryType="nt:unstructured"
                            listOrder="9"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="body"
                            fieldLabel="Body"
                            required="on"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            metaType="text-multi"
                            valueType="string"
                            default-mime-type="text/html"
                            cfm-element="true"/>
                        <quotes
                            jcr:primaryType="nt:unstructured"
                            listOrder="10"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="quotes"
                            fieldLabel="Quotes"
                            fieldDescription="Pull quotes shown in the body, in order."
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                            metaType="fragment-reference"
                            valueType="string/content-fragment[]"
                            fragmentmodelreference="[/conf/saudiaeds/settings/dam/cfm/models/quote]"
                            rootPath="/content/dam/saudiaeds"
                            allowNew="true"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
