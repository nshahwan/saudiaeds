<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[^/content/dam/saudiaeds(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/saudiaeds/settings/dam/cfm/models/story/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description='One story in a stories list (home "Exceptional experiences with Saudia").'
        jcr:primaryType="cq:PageContent"
        jcr:title="Story"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <model
            cq:targetPath="/content/entities"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            jcr:primaryType="cq:PageContent"
            maxGeneratedOrder="20"
            sling:resourceType="wcm/scaffolding/components/scaffolding">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <title
                            jcr:primaryType="nt:unstructured"
                            listOrder="1"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="title"
                            fieldLabel="Title"
                            required="on"
                            fieldDescription='e.g. "Saudia Named “Best Airline Staff Service” at the 2025 Skytrax Awards".'
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                        <summary
                            jcr:primaryType="nt:unstructured"
                            listOrder="2"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="summary"
                            fieldLabel="Summary"
                            fieldDescription="One or two sentences under the title."
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="500"/>
                        <image
                            jcr:primaryType="nt:unstructured"
                            listOrder="3"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="image"
                            fieldLabel="Image (desktop)"
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/dam/saudiaeds"
                            showThumbnail="true"
                            validation="cfm.validation.contenttype.image"/>
                        <imageMobile
                            jcr:primaryType="nt:unstructured"
                            listOrder="4"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="imageMobile"
                            fieldLabel="Image (mobile)"
                            fieldDescription="Optional; the desktop image is used when empty."
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/dam/saudiaeds"
                            showThumbnail="true"
                            validation="cfm.validation.contenttype.image"/>
                        <imageAlt
                            jcr:primaryType="nt:unstructured"
                            listOrder="5"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="imageAlt"
                            fieldLabel="Image alt text"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="500"/>
                        <pressRelease
                            jcr:primaryType="nt:unstructured"
                            listOrder="6"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="pressRelease"
                            fieldLabel="Press release"
                            fieldDescription="Optional: the press release page the story is about; the story links to it."
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/saudiaeds"
                            showThumbnail="false"/>
                        <link
                            jcr:primaryType="nt:unstructured"
                            listOrder="7"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="link"
                            fieldLabel="Link"
                            fieldDescription="Where the story links to when no press release is picked (a page path or a full URL)."
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="2000"/>
                        <linkText
                            jcr:primaryType="nt:unstructured"
                            listOrder="8"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="linkText"
                            fieldLabel="Link text"
                            fieldDescription='Defaults to "Learn more".'
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
