<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[^/content/dam/saudiaeds(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/saudiaeds/settings/dam/cfm/models/story/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description='One story in a stories list (home "Exceptional experiences with Saudia").'
        jcr:primaryType="cq:PageContent"
        jcr:title="Story"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <model
            cq:targetPath="/content/entities"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            jcr:primaryType="cq:PageContent"
            maxGeneratedOrder="20"
            sling:resourceType="wcm/scaffolding/components/scaffolding">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="20">
                        <title
                            jcr:primaryType="nt:unstructured"
                            listOrder="1"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="title"
                            fieldLabel="Title"
                            required="on"
                            fieldDescription="The story heading."
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="255"/>
                        <summary
                            jcr:primaryType="nt:unstructured"
                            listOrder="2"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="summary"
                            fieldLabel="Summary"
                            fieldDescription="One or two sentences under the title."
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="500"/>
                        <image
                            jcr:primaryType="nt:unstructured"
                            listOrder="3"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="image"
                            fieldLabel="Image"
                            fieldDescription="Shown beside the text on desktop, above it on mobile."
                            sling:resourceType="dam/cfm/models/editor/components/contentreference"
                            metaType="reference"
                            valueType="string"
                            rootPath="/content/dam/saudiaeds"
                            showThumbnail="true"/>
                        <imageAlt
                            jcr:primaryType="nt:unstructured"
                            listOrder="4"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="imageAlt"
                            fieldLabel="Image alt text"
                            fieldDescription="Leave empty when the image only illustrates the heading."
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="500"/>
                        <link
                            jcr:primaryType="nt:unstructured"
                            listOrder="5"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            name="link"
                            fieldLabel="Link"
                            fieldDescription='Where "Learn more" goes: a site path (/en/…) or a full URL.'
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            metaType="text-single"
                            valueType="string"
                            maxlength="2000"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
