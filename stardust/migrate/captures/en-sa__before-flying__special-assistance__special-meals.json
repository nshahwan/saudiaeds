hidden=\"true\" class=\"swiper-slide__image desktop-view ng-star-inserted\"><img fetchpriority=\"high\" alt=\"\" width=\"1920\" height=\"600\" src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/Campaign-Banner/2024/04/our-network.ashx?h=600&amp;iar=0&amp;w=1920&amp;rev=e2768e4f88904bb1b1f1a61a41d9a908&amp;hash=1CE2AB2D29E976DF8BFE2C871A5076A2\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"59e796f5-3e26-496b-8e61-890125891702\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><h1 appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">Special Meals</span><!----></h1><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n\n<section class=\"special-meals-section\">\n\n  <div class=\"special-meals-content\">\n\n    <h2 class=\"fs-1-5 vg-0--top\">Special Meals</h2>\n\n    <p class=\"special-meals-intro\">\n      Saudia provides a wide variety of special meals for guests who, for dietary or health reasons, require specific\n      meal options, as well as for guests traveling with infants. You can request a special meal on any flight where a\n      meal service is normally provided.\n    </p>\n\n    <h3 class=\"fs-1-3 vg-0--top\">\n      The following types of special meals are available and can be requested as alternatives to standard meals:\n    </h3>\n\n    <div class=\"special-meals-list\">\n      <ol>\n        <li>Low Calorie Meal</li>\n        <li>Hindu Meal</li>\n        <li>Baby Food</li>\n        <li>Asian Vegetarian Meal</li>\n        <li>Vegetarian Meal</li>\n        <li>Low Salt Meal</li>\n        <li>Child Meal</li>\n        <li>Bland Meal</li>\n        <li>Diabetic Meal</li>\n        <li>Low Fat Meal</li>\n        <li>Autism Meal</li>\n        <li>Fruit Platter</li>\n        <li>Lacto-ovo Vegetarian Meal</li>\n        <li>Gluten Free Meal</li>\n      </ol>\n    </div>\n\n    <h3 class=\"fs-1-3 vg-0--top\">\n      Specially designed meals for guests with disabilities:\n    </h3>\n\n    <div class=\"special-meals-accessibility\">\n<ul>\n        <li>Meal tailored for guests with autism.</li>\n      </ul>\n    </div>\n\n    <p class=\"special-meals-note\">\n      To help celebrate special occasions, Saudia can also provide a celebration cake for weddings, honeymoons, or\n      similar events on international flights.\n    </p>\n\n  </div>\n</section></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}