--content-embedded h--left v--top image--teaser ng-star-inserted\"><!----><div appswiper=\"\" fxflex=\"auto\" class=\"swiper-container ng-star-inserted swiper-initialized swiper-horizontal swiper-backface-hidden\"><div class=\"swiper-wrapper\"><div class=\"swiper-slide ng-star-inserted swiper-slide-active\"><div fxlayout=\"column\" fxlayoutalign=\"\" fxflexfill=\"\"><div aria-hidden=\"true\" class=\"swiper-slide__image desktop-view ng-star-inserted\"><img fetchpriority=\"high\" alt=\"\" width=\"1920\" height=\"352\" src=\"/-/media/SaudiaWebApp/data/media/img/Alfursan/20112023-alfursan-lounge-top.ashx?h=352&amp;iar=0&amp;w=1920&amp;rev=704d813b15b64959907c291b7aa76bba&amp;hash=ECD12279890FA9075030B6A1A8113464\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"621bd677-245d-43ec-98a3-b534e7ac4cc3\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><!----><h2 appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">LOUNGES INFORMATION</span><!----></h2><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container container--vertical\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\"><p class=\"lounge-description\">Enjoy access to our exclusive worldwide lounges and unwind before your next flight.\nOur airport lounges are thoughtfully designed to offer a range of amenities that will make your journey as enjoyable as possible.\nLounge access is available to AlFursan members and their guests, depending on membership tier and travel class.\nFind all the information about lounge access policy below.</p>\n\n<div class=\"lounge-modal-box\">\n  <h3 class=\"lounge-modal-title\">AlFursan Member Guest Access Policy</h3>\n\n  <table>\n    <caption>\n      AlFursan Member Guest Access Policy\n    </caption>\n    <thead>\n      <tr>\n        <th>GOLD</th>\n        <th>Saudia Lounge</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td><strong>FIRST CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International Flight:</strong> <strong>3</strong> Family members<br>\n          <strong>1</strong> Guest Invite<br>\n          <strong>Domestic Flight:</strong> Only AlFursan members can access.\n        </td>\n      </tr>\n      <tr>\n        <td><strong>BUSINESS CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International:</strong> <strong>2</strong> Family members<br>\n          <strong>1</strong> Guest<br>\n          <strong>Domestic:</strong> Only AlFursan members can access.\n        </td>\n      </tr>\n      <tr>\n        <td><strong>GUEST CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International Flight:</strong> <strong>1</strong> Family member<br>\n          <strong>1</strong> Guest Invite\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n  <table>\n    <caption>\n      AlFursan Member Guest Access Policy\n    </caption>\n    <thead>\n      <tr>\n        <th>SILVER</th>\n        <th>&nbsp;</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td><strong>FIRST CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International:</strong> <strong>3</strong> Family members<br>\n          <strong>Domestic:</strong> Only AlFursan members can access.\n        </td>\n      </tr>\n      <tr>\n        <td><strong>BUSINESS CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International:</strong> <strong>2</strong> Family members<br>\n          <strong>Domestic:</strong> Only AlFursan members can access.\n        </td>\n      </tr>\n      <tr>\n        <td><strong>GUEST CLASS:</strong> boarding pass holder</td>\n        <td>\n          <strong>International:</strong> <strong>1</strong> Family member<br>\n          <strong>Domestic:</strong> Only AlFursan members can access.\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n  <p>\n    * Guests and family members must be traveling on the same date/flight.<br>\n    Please note: Some Lounges might not be accessible to you; eligibility will be checked at the entrance by the employee in charge.\n  </p>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text-button class=\"n