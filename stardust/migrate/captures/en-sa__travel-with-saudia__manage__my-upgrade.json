-gradient\" id=\"367ebf32-61bf-472b-a3f8-26cb4b470b92\"></div></div><!----><!----></div></div><div class=\"cms-img-component-content container h--left ng-star-inserted\"><div class=\"cms-img-content-wrapper\"><!----><h2 appaddtextlimit=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">MY UPGRADE</span><!----></h2><!----><!----><div><app-jss-count-down-timer><!----></app-jss-count-down-timer></div><!----></div><div class=\"cms-img-container\"><div class=\"desktop-view ng-star-inserted\"><img src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/installments-background.ashx?h=290&amp;iar=0&amp;w=1920&amp;rev=56bbf894fcf94053bc147052f43b3bbc&amp;hash=02A1C4F406BC1398D5E79E05E4655F95\" alt=\"MY UPGRADE\"><div class=\"image-gradient\" id=\"367ebf32-61bf-472b-a3f8-26cb4b470b92\"></div></div><!----><!----></div></div><!----></section></app-jss-image><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text-button class=\"ng-star-inserted\"><div class=\"cms-title-text-button-container ng-star-inserted\"><!----><p appaddtextlimit=\"\" class=\"description ng-star-inserted\"><span class=\"ng-star-inserted\"><h2 class=\"upgraded-title\">Let's get you upgraded</h2>\n<p>Here's your chance. Get upgraded so you can experience the best features, services, and entertainment*.</p>\n<p>Enter your details in the fields shown to check if your reservation is eligible to make an offer.</p>\n<p>Search for a Reservation</p>\n<form class=\"upgradeForm\" id=\"pg_offering\">\n    <div><label for=\"pg_recordLocator\">Booking reference number</label>\n    <div><input name=\"pg_recordLocator\" type=\"text\" id=\"pg_recordLocator\"></div>\n    </div>\n    \n    <div>\n    <div>\n    <div class=\"mt-4\"><label for=\"pg_lastName\">Last Name</label>\n    <div><input name=\"pg_lastName\" type=\"text\" id=\"pg_lastName\"></div>\n    </div>\n    </div>\n    </div>\n    \n    <div class=\"mt-4\"><button name=\"pg_submit\" class=\"btn button-primary-dark mat-button\">Get Upgraded</button></div>\n    <input type=\"hidden\" name=\"pg_apiKey\" value=\"xyFmZQHwAlBy2bKmjfMqDnxS\">\n    <input type=\"hidden\" name=\"pg_language\" value=\"en\">\n</form></span><!----></p><!----><!----><div class=\"link--text\"><!----></div></div><!----><!----></app-jss-title-text-button><app-jss-scripts class=\"ng-star-inserted\"></app-jss-scripts><!----></sc-placeholder></div><!----><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-image class=\"ng-star-inserted\"><section class=\"cms-img-component only-img\"><div class=\"cms-img-wrapper\"><div class=\"cms-img-container\"><div class=\"desktop-view ng-star-inserted\"><!----><img src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/My_Upgrade_2.ashx?h=350&amp;iar=0&amp;w=625&amp;rev=d8804c8d647a49f78b4da9e4f0933d15&amp;hash=D6C0C9CBD2845819C16E91D20D790B47\" alt=\"\"><div class=\"image-gradient\" id=\"d4723978-179c-4316-be92-14b96229213d\"></div></div><!----><!----></div></div><!----></section></app-jss-image><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text-button class=\"ng-star-inserted\"><div class=\"cms-title-text-button-container ng-star-inserted\"><!----><p appaddtextlimit=\"\" class=\"description ng-star-inserted\"><span class=\"ng-star-inserted\"><div class=\"clearfix\">\n<div class=\"floating-img\">\n<img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/SAUDIA-My-Upgrade-Logo.ashx?rev=0f13495df2614576a537653353a6efeb&amp;hash=910D495DFEB5A91E6D64A58C2DEA1469\">&nbsp;</div>\n<br>\n<h2>How to Upgrade?</h2>\n<br>\n<ul class=\"list-no-style\">\n    <li>\n    <h3><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/Complete-your-data.ashx?rev=21ed67e99af94d1780bd92be43572c43&amp;hash=39FB6B0ED375A7BD6BE90454B5F5E4AC\">Complete your data</h3>\n    <p>In the table shown, enter your reservation number and last name.</p>\n    </li>\n    <br>\n    <li>\n    <h3><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/Make-your-upgrade-offer.ashx?rev=97b34ce700534a4197dd725e3f5dd733&amp;hash=AA1CA1B084D39DD74CCD6F19F8CF6601\">Make your upgrade offer</h3>\n    <p>Name your price to upgrade each leg of your flight.</p>\n    </li>\n    <br>\n    <li>\n    <h3><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/Enter-your-payment-options.ashx?rev=14f707b4ea6d4422804963bf938709e7&amp;hash=D8018C87E1C685065769FC044AD9D7B4\">Enter your payment information</h3>\n    <p>Enter the details of your credit card. If your offer is accepted, you will be billed for the upgrade*.</p>\n    <p>If not, you pay nothing and keep the seat you have.</p>\n    <p>A confirmation e-mail will be sent to you that includes your bidding offer details.</p>\n    </li>\n    <br>\n    <li>\n    <h3> <img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/SXAPages/MyUpgrade/Complete-your-data.ashx?rev=21ed67e99af94d1780bd92be43572c43&amp;hash=39FB6B0ED375A7BD6BE90454B5F5E4AC\">Check and confirm\n    </h3>\n    <p>Review your information and send us your offer. We'll notify you via email if your request for an upgrade has been approved.</p>\n    </li>\n</ul>\n<p><em>* Note:</em></p>\n<br>\n<ul>\n    <li>The bid offered for the upgrade is in addition to the price of your original Guest Class ticket.</li>\n    <li>Free Onboard Internet connection is not included.</li>\n    <li>MY UPGRADE is available through (Saudia website, Check-in counter, and Boarding gate). <br>\n    For more information, please contact the agent at each channel.</li>\n</ul>\n<p>To view the Terms and Conditions, click <a href=\"/en-SA/information/terms-and-conditions/my-upgrade\">here</a>.</p>\n</div></span><!----></p><!----><!----><div class=\"link--text\"><!----></div></div><!----><!----></app-jss-title-text-button><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}