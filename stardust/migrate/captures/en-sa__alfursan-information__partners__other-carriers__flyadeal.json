=\"high\" alt=\"flyadeal-Partnership\" width=\"1920\" height=\"590\" src=\"/-/media/SaudiaWebApp/data/media/img/Alfursan/2025/06/Flyadeal-Partnership-web-Banner-1920-600.ashx?h=590&amp;iar=0&amp;w=1920&amp;rev=592984f9928145a78df921f98eb162c2&amp;hash=6EC287A2C15CEC92689444FB0E937676\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"9b8d3501-9660-4745-96f2-a03fd3b7f853\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><h2 appexcerpttext=\"\" class=\"UpdateHeading ng-star-inserted\">The Thousand-Mile Journey, Made Real with flyadeal</h2><!----><!----><!----><!----><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\"><p>Now you can easily earn and redeem AlFursan Miles onboard flyadeal!</p>\n<p>Add your Miles in simple steps and create memories that last <strong>ForLife</strong>.</p></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\"><p>Earn more Miles, unlock exclusive benefits, and enjoy:</p>\n<div class=\"custom-content__wrapper\">\n<div class=\"container\">\n<div>\n<ul>\n</ul>\n</div>\n&nbsp;<section class=\"custom-content__section\">\n<ol>\n    <div class=\"list-wrapper\">\n    <div class=\"list-number\">\n    <li></li>\n    </div>\n    <div class=\"list-contents\">\n    <span class=\"contents-heading\">Reward Miles</span>\n    </div>\n    </div>\n    <div class=\"list-wrapper\">\n    <div class=\"list-number\">\n    <li></li>\n    </div>\n    <div class=\"list-contents\">\n    <span class=\"contents-heading\">Exclusive benefits</span>\n    </div>\n    </div>\n    <div class=\"list-wrapper\">\n    <div class=\"list-number\">\n    <li></li>\n    </div>\n    <div class=\"list-contents\">\n    <span class=\"contents-heading\">Additional seats</span>\n    </div>\n    </div>\n    <div class=\"list-wrapper\">\n    <div class=\"list-number\">\n    <li></li>\n    </div>\n    <div class=\"list-contents\">\n    <span class=\"contents-heading\">More destinations</span>\n    </div>\n    </div>\n</ol>\n</section>\n<section class=\"custom-content__section\"><br>\n</section>\n</div>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n<h2>How to Earn Miles with flyadeal</h2>\n<ul>\n    <li>You can earn AlFursan Miles when flying with flyadeal.</li>\n    <li>Miles are awarded based on the fare class selected (<strong>Fly+</strong> or <strong>FlyMax</strong>) and the distance traveled.</li>\n</ul>\n<h2>How to Redeem Your Miles</h2>\n<ul>\n    <li>Redeem your Miles for any available seat with no restrictions or capacity limitations.</li>\n    <li>You can redeem the full value of your flight, including taxes and fees.</li>\n</ul>\n<table class=\"route-table\" role=\"table\">\n    <thead>\n        <tr>\n            <th scope=\"col\">Fare</th>\n            <th scope=\"col\">Redeeming Miles</th>\n            <th scope=\"col\">Earning Miles</th>\n            <th scope=\"col\">Average of earned Miles (based on distance traveled)</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td data-label=\"Fare\">Fly</td>\n            <td data-label=\"Redeeming Miles\">Yes</td>\n            <td data-label=\"Earning Miles\">No</td>\n            <td data-label=\"Average of earned Miles (based on distance traveled)\">-</td>\n        </tr>\n        <tr>\n            <td data-label=\"Fare\">Fly+</td>\n            <td data-label=\"Redeeming Miles\">Yes</td>\n            <td data-label=\"Earning Miles\">Yes</td>\n            <td data-label=\"Average of earned Miles (based on distance traveled)\">60%</td>\n        </tr>\n        <tr>\n            <td data-label=\"Fare\">FlyMax</td>\n            <td data-label=\"Redeeming Miles\">Yes</td>\n            <td data-label=\"Earning Miles\">Yes</td>\n            <td data-label=\"Average of earned Miles (based on distance traveled)\">100%</td>\n        </tr>\n    </tbody>\n</table>\n<h2>Adding Miles</h2>\n<ul>\n    <li>You can add your AlFursan membership number during booking to ensure Miles are credited correctly.</li>\n    <li>Miles earned from flyadeal flights will be automatically credited to your AlFursan account by entering your membership number.</li>\n    <li>You can also claim missing Miles retroactively within 6 months of the travel date.</li>\n</ul>\n<p>Embark on your journey with AlFursan and flyadeal today!</p></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-faq class=\"ng-star-inserted\"><div class=\"faq-section ng-star-inserted\"><div class=\"container\"><div fxlayout=\"row\" fxlayout.lt-lg=\"column\" fxlayoutgap=\"20px grid\" fxlayoutgap.gt-lg=\"24px grid\"><div fxflex.gt-lg=\"50\" class=\"faq__title\"><h2 class=\"primary-heading ng-star-inserted\" aria-label=\"\">Frequently asked questions</h2><!----><div class=\"all-faqs ng-star-inserted\"><a id=\"viewAllFaq\" class=\"faq_link_button ng-star-inserted\" target=\"_self\" href=\"/-/media/SaudiaWebApp/data/media/files/Loyalty/FAQ-flyadeal--X-Alfursan.ashx?rev=-1\n                  \" aria-label=\"\"><span> View all FAQs </span><span aria-hidden=\"true\" class=\"material-icons-outlined faq_icon icon-Link_chevron\"> chevron_right </span></a><!----></div><!----></div><div fxflex.gt-lg=\"50\"><mat-accordion class=\"mat-accordion faq__accordion\"><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-0 mat-expanded mat-expansion-panel-spacing ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-1 ng-tns-c1859850774-0 ng-animate-disabled mat-expanded mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Can I earn Miles when flying with flyadeal?\" id=\"mat-expansion-panel-header-0\" aria-controls=\"cdk-accordion-child-0\" aria-expanded=\"true\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-1\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-1\"> Can I earn Miles when flying with flyadeal? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-1 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-0 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-0\" aria-labelledby=\"mat-expansion-panel-header-0\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-0\"><p class=\"mat-panel-body-custom ng-star-inserted\"><span> </span>Yes, as an AlFursan Program member, you can earn Reward Miles when flying onboard flyadeal. Please make sure to enter your AlFursan membership number during booking.<br>\nTier Miles will be credited during the offer period from 23 June 2025 to 30 June 2026. If you’re not a member yet, kindly register <a rel=\"noopener noreferrer\" href=\"https://www.saudia.com/en-SA/Register\" target=\"_blank\">here</a><br>\n<div>&nbsp;</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-2 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-3 ng-tns-c1859850774-2 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Can I redeem my AlFursan Reward Miles to book flyadeal flights?\" id=\"mat-expansion-panel-header-1\" aria-controls=\"cdk-accordion-child-1\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-3\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-3\"> Can I redeem my AlFursan Reward Miles to book flyadeal flights? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-3 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-2 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-1\" aria-labelledby=\"mat-expansion-panel-header-1\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-2\"><p class=\"mat-panel-body-custom ng-star-inserted\">Yes. You can use your Reward Miles to book on flyadeal flights. Unlimited Seat Availability, no blackout restrictions or limited inventory. If there’s a seat for sale, it’s available for redemption.</p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-4 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-5 ng-tns-c1859850774-4 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Can I benefit from the perks of AlFursan Silver and Gold Tiers onboard flyadeal?\" id=\"mat-expansion-panel-header-2\" aria-controls=\"cdk-accordion-child-2\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-5\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-5\"> Can I benefit from the perks of AlFursan Silver and Gold Tiers onboard flyadeal? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-5 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-4 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-2\" aria-labelledby=\"mat-expansion-panel-header-2\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-4\"><p class=\"mat-panel-body-custom ng-star-inserted\">No, you cannot benefit from the perks of AlFursan Silver and Gold Tiers, which include:<br>\n●<span> </span> Lounge access.<br>\n●<span> </span> Priority access.<br>\n●<span> </span> Extra baggage.<br>\n●<span> </span> Priority boarding .<br></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-6 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-7 ng-tns-c1859850774-6 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Can I receive AlFursan Reward Miles on a booking made before the partnership announcement, for a flight scheduled after the launch date?\" id=\"mat-expansion-panel-header-3\" aria-controls=\"cdk-accordion-child-3\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-7\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-7\"> Can I receive AlFursan Reward Miles on a booking made before the partnership announcement, for a flight scheduled after the launch date? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-7 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-6 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-3\" aria-labelledby=\"mat-expansion-panel-header-3\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-6\"><p class=\"mat-panel-body-custom ng-star-inserted\">No, this service is available only for bookings issued on or after the partnership announcement date: Monday, June 23, 2025.</p><!----><!----></div></div></mat-expansion-panel><!----><!----></mat-accordion></div></div></div></div><!----></app-jss-faq><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-faq class=\"ng-star-inserted\"><div class=\"faq-section ng-star-inserted\"><div class=\"container\"><div fxlayout=\"row\" fxlayout.lt-lg=\"column\" fxlayoutgap=\"20px grid\" fxlayoutgap.gt-lg=\"24px grid\"><div fxflex.gt-lg=\"50\" class=\"faq__title\"><h2 class=\"primary-heading ng-star-inserted\" aria-label=\"\">Terms and Conditions</h2><!----><!----></div><div fxflex.gt-lg=\"50\"><mat-accordion class=\"mat-accordion faq__accordion\"><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-8 mat-expanded mat-expansion-panel-spacing ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-9 ng-tns-c1859850774-8 ng-animate-disabled mat-expanded mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Benefits\" id=\"mat-expansion-panel-header-4\" aria-controls=\"cdk-accordion-child-4\" aria-expanded=\"true\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-9\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-9\"> Benefits </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-9 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-8 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-4\" aria-labelledby=\"mat-expansion-panel-header-4\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-8\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n<li>AlFursan Reward Miles can be redeemed for any flyadeal flight.</li>\n<li>Unlimited Seat Availability, no blackout restrictions or limited inventory. If there’s a seat for sale, it’s available for redemption.</li>\n<li>Reward Miles cannot be redeemed for add-ons such as seats, meals, baggage, or other ancillary services. These can be added after confirmation and payment using the available payment methods via “Manage My Booking”.</li>\n<li>The full cost of your flyadeal flight, including applicable fees and taxes, can be redeemed using Reward Miles.</li>\n<li>AlFursan Tier benefits (e.g., priority check-in, lounge access, additional baggage) are not applicable on flyadeal (F3) flights. No exceptions or reimbursements will be offered for the unavailability of Tier benefits.</li>\n</ul>\n<br class=\"t-last-br\"></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-10 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-11 ng-tns-c1859850774-10 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Eligibility\" id=\"mat-expansion-panel-header-5\" aria-controls=\"cdk-accordion-child-5\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-11\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-11\"> Eligibility </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-11 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-10 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-5\" aria-labelledby=\"mat-expansion-panel-header-5\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-10\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n    <li>Only registered AlFursan members are eligible to earn or redeem Reward Miles on flyadeal flights bookings issued on or after the partnership announcement date: Monday, June 23, 2025.</li>\n    <li>Non-members can register for an AlFursan account and retroactively claim Reward Miles for eligible bookings issued on or after the partnership announcement date: Monday, June 23, 2025, within 6 months by providing proof of travel.</li>\n</ul>\n<br class=\"t-last-br\"></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-12 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-13 ng-tns-c1859850774-12 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Earning Reward Miles\" id=\"mat-expansion-panel-header-6\" aria-controls=\"cdk-accordion-child-6\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-13\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-13\"> Earning Reward Miles </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-13 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-12 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-6\" aria-labelledby=\"mat-expansion-panel-header-6\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-12\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n    <li>Reward miles are earned based on the distance flown and the fare bundle selected:\n<ul>\n    <li>flyMax: 80% of the distance flown.</li>\n    <li>fly+: 60% of the distance flown.</li>\n    <li>fly: Not eligible for earning Miles.</li>\n</ul>\n    </li>\n    <li>Reward miles are awarded only for flown, scheduled flyadeal flights.</li>\n    <li>Only Reward Miles will be credited. Tier credits will also be awarded during the promotional period of three months, from 23 June 2025 to 30 September 2025.</li>\n</ul></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-14 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-15 ng-tns-c1859850774-14 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Redeeming Reward Miles\" id=\"mat-expansion-panel-header-7\" aria-controls=\"cdk-accordion-child-7\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-15\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-15\"> Redeeming Reward Miles </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-15 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-14 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-7\" aria-labelledby=\"mat-expansion-panel-header-7\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-14\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n<li>AlFursan members can redeem Reward Miles on any scheduled flyadeal flight, for unlimited seat availability.</li>\n<li>When redeeming AlFursan Reward Miles, the member must have a sufficient Miles balance in their account to cover the complete redemption for a flyadeal flight no partial Reward Miles payments allowed.</li>\n<li>All redemptions are subject to flyadeal’s general conditions of carriage.</li>\n<li>Redemption values follow the applicable flyadeal fare at the time of booking.</li>\n<li>Reward Miles can only be redeemed on scheduled flyadeal flights.</li>\n<li>Redeeming a flight includes the flight cost, applicable fees, and taxes. All will be fully covered by Reward Miles. </li>\n<li>Reward Miles cannot be earned on redemption tickets.</li>\n<li>Members may redeem flights for themselves or for another individual.</li>\n</ul>\n<br class=\"t-last-br\">\n</p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-16 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-17 ng-tns-c1859850774-16 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Claims and Retroactive Credit\" id=\"mat-expansion-panel-header-8\" aria-controls=\"cdk-accordion-child-8\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-17\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-17\"> Claims and Retroactive Credit </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-17 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-16 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-8\" aria-labelledby=\"mat-expansion-panel-header-8\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-16\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n <li>Claims for missing Reward Miles must be submitted via the AlFursan website or Saudia app within 6 months of the flight date for flights bookings issued as of the partnership announcement date on Monday, June 23, 2025.</li>\n<li>Supporting documents such as original boarding passes and tickets are required.</li>\n<li>Retroactive credit is subject to verification by both AlFursan and flyadeal.</li>\n</ul>\n<br class=\"t-last-br\"></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-18 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-19 ng-tns-c1859850774-18 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Flight Irregularities\" id=\"mat-expansion-panel-header-9\" aria-controls=\"cdk-accordion-child-9\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-19\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-19\"> Flight Irregularities </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-19 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-18 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-9\" aria-labelledby=\"mat-expansion-panel-header-9\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-18\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n<li>In the case of delays, cancellations, or denied boarding, Reward Miles paid passengers will receive the same level of care and rebooking support as paid passengers.</li>\n<li>For such disruptions, affected members may request Reward Miles refunds through the AlFursan portal. Reward Miles refunds are subject to verification by both AlFursan and flyadeal.</li>\n<li>Reward Miles will be awarded on flown flights.</li>\n</ul>\n<br class=\"t-last-br\"></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-20 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-21 ng-tns-c1859850774-20 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Privacy\" id=\"mat-expansion-panel-header-10\" aria-controls=\"cdk-accordion-child-10\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-21\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-21\"> Privacy </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-21 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-20 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-10\" aria-labelledby=\"mat-expansion-panel-header-10\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-20\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n<li>Member data shared between AlFursan and flyadeal will be used solely for the fulfilment of programme services.</li>\n<li>All personal data will be handled in accordance with applicable data protection laws.</li>\n<li>Member data will not be sold or shared with third parties beyond operational requirements.</li>\n</ul>\n<br class=\"t-last-br\"></p><!----><!----></div></div></mat-expansion-panel><!----><!----></mat-accordion></div></div></div></div><!----></app-jss-faq><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}