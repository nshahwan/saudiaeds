header-pagination mat-tab-header-pagination-after mat-elevation-z4 mat-tab-header-pagination-disabled\" disabled=\"\" role=\"button\" aria-label=\"Next slide\"><div class=\"mat-tab-header-pagination-chevron\"></div></button></mat-tab-header><div class=\"mat-tab-body-wrapper\"><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-19 mat-tab-body-active ng-star-inserted\" id=\"mat-tab-content-0-0\" aria-labelledby=\"mat-tab-label-0-0\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-19 ng-trigger ng-trigger-translateTab\"><!----><div class=\"ng-star-inserted\"><p appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">\n\n<div class=\"fare-wrapper\" dir=\"ltr\">\n  <img alt=\"SkyTeam alliance network map\" src=\"/-/media/SaudiaWebApp/data/media/img/NEW2026/SKYTEAM/skyteam-2025-apr-(1).ashx?rev=a953e623d10540baa553670ff22fd7ae&amp;hash=BA16AD1AA1E0B86E5C160B84BF765AF2\" class=\"saudia-banner-img\">\n  \n  <input type=\"radio\" id=\"acc-none\" name=\"saudia-accordion\" class=\"acc-toggle\" checked=\"\">\n\n  <div class=\"fare-card\">\n    <input type=\"radio\" id=\"acc-overview\" name=\"saudia-accordion\" class=\"acc-toggle\">\n    <div class=\"acc-header\">\n      <label for=\"acc-overview\" class=\"acc-summary acc-open\">\n        <span class=\"fare-card-title\">Overview</span>\n      </label>\n      <label for=\"acc-none\" class=\"acc-close\" aria-label=\"Close panel\"></label>\n    </div>\n    <div class=\"acc-panel\">\n      <div class=\"acc-inner\">\n        <div class=\"content-body\">\n          <h3 class=\"saudia-h3-spacing\">SkyTeam Flying High With New Members</h3>\n          <p>SkyTeam, the second largest global alliance, with 19 airlines on board, offers approximately 14,500+ daily flights to 1036+ destinations in 175+ countries to explore.</p>\n          <p>SkyTeam was established in June 2000 with the participation of four airlines: Aeroméxico, Delta Air Lines, Air France and Korean Air. Current members include: Saudia, KLM, Delta, Air France, and many more.</p>\n          <h3 class=\"saudia-h3-spacing\">Cost Savings</h3>\n          <p>Members enjoy cost-savings from joint synergies through co-locations, which maximize airport facility utilization and reduce ground handling costs.</p>\n          <h3 class=\"saudia-h3-spacing\">SkyTeam Livery</h3>\n          <p>The SkyTeam livery design was inspired by the alliance's logo. It features:</p>\n          <ul class=\"saudia-list--unordered\">\n            <li>The dark blue SkyTeam logo on the tail fin.</li>\n            <li>The blue SkyTeam ribbon wrapped around the fuselage.</li>\n            <li>Large dark blue SkyTeam lettering on the front.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fare-card\">\n    <input type=\"radio\" id=\"acc-products\" name=\"saudia-accordion\" class=\"acc-toggle\">\n    <div class=\"acc-header\">\n      <label for=\"acc-products\" class=\"acc-summary acc-open\">\n        <span class=\"fare-card-title\">Products and Services</span>\n      </label>\n      <label for=\"acc-none\" class=\"acc-close\" aria-label=\"Close panel\"></label>\n    </div>\n    <div class=\"acc-panel\">\n      <div class=\"acc-inner\">\n        <div class=\"content-body\">\n          <h3 class=\"saudia-h3-spacing\">SkyTeam Products &amp; Services</h3>\n          <ul class=\"saudia-list--unordered\">\n            <li>Go Round the World fare pass.</li>\n            <li>Regional passes: Go Africa, Go Asia, Go Europe, etc.</li>\n            <li>SkyTeam Global Corporate Contracts.</li>\n            <li>Access to more than 503 airport lounges worldwide.</li>\n          </ul>\n          <h3 class=\"saudia-h3-spacing\">In-Flight Services</h3>\n          <p>English is spoken on every flight in addition to the carrier's native language. In-flight programming includes healthy travel tips and exercises.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fare-card\">\n    <input type=\"radio\" id=\"acc-benefits\" name=\"saudia-accordion\" class=\"acc-toggle\">\n    <div class=\"acc-header\">\n      <label for=\"acc-benefits\" class=\"acc-summary acc-open\">\n        <span class=\"fare-card-title\">Benefits</span>\n      </label>\n      <label for=\"acc-none\" class=\"acc-close\" aria-label=\"Close panel\"></label>\n    </div>\n    <div class=\"acc-panel\">\n      <div class=\"acc-inner\">\n        <div class=\"content-body\">\n          <h3 class=\"saudia-h3-spacing\">Frequent Flyer Benefits</h3>\n          <div class=\"saudia-table-wrapper\">\n            <table class=\"saudia-table\">\n              <thead>\n                <tr>\n                  <th>Benefits</th>\n                  <th>Elite</th>\n                  <th>Elite Plus</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <td>Lounge access</td>\n                  <td>-</td>\n                  <td>✔</td>\n                </tr>\n                <tr>\n                  <td>Priority check-in</td>\n                  <td>✔</td>\n                  <td>✔</td>\n                </tr>\n                <tr>\n                  <td>Priority boarding</td>\n                  <td>✔</td>\n                  <td>✔</td>\n                </tr>\n                <tr>\n                  <td>Priority baggage delivery</td>\n                  <td>-</td>\n                  <td>✔</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n          <p><strong>Extra baggage:</strong> 1 extra piece or 10-20kg depending on status.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fare-card\">\n    <input type=\"radio\" id=\"acc-skypriority\" name=\"saudia-accordion\" class=\"acc-toggle\">\n    <div class=\"acc-header\">\n      <label for=\"acc-skypriority\" class=\"acc-summary acc-open\">\n        <span class=\"fare-card-title\">SkyPriority</span>\n      </label>\n      <label for=\"acc-none\" class=\"acc-close\" aria-label=\"Close panel\"></label>\n    </div>\n    <div class=\"acc-panel\">\n      <div class=\"acc-inner\">\n        <div class=\"content-body\">\n          <img alt=\"SkyPriority branding\" src=\"https://www.saudia.com/pages/-/media/Project/SA/SC/SV_Content/images/sky-priority.JPG\" class=\"saudia-banner-img\">\n          <p>SkyPriority unites exclusive airport benefits into one consistent experience for First/Business class and AlFursan Gold members.</p>\n          <a rel=\"noopener noreferrer\" href=\"https://www.skyteam.com/en/skypriority-page/\" target=\"_blank\" class=\"saudia-btn saudia-btn--primary\">Find SkyPriority services</a>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"fare-card\">\n    <input type=\"radio\" id=\"acc-meetings\" name=\"saudia-accordion\" class=\"acc-toggle\">\n    <div class=\"acc-header\">\n      <label for=\"acc-meetings\" class=\"acc-summary acc-open\">\n        <span class=\"fare-card-title\">SkyTeam Global Meetings</span>\n      </label>\n      <label for=\"acc-none\" class=\"acc-close\" aria-label=\"Close panel\"></label>\n    </div>\n    <div class=\"acc-panel\">\n      <div class=\"acc-inner\">\n        <div class=\"content-body\">\n          <p>Global Meetings covers over 1150+ destinations. Register your event to get exclusive discounts for attendees.</p>\n          <a rel=\"noopener noreferrer\" href=\"http://www.skyteam.com/en/Supporting-your-business/\" target=\"_blank\" class=\"saudia-btn saudia-btn--primary\">Explore Global Meetings</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div></span><!----></p><!----></div><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-20 ng-star-inserted\" id=\"mat-tab-content-0-1\" aria-labelledby=\"mat-tab-label-0-1\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-20 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-bo