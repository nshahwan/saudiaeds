rc=\"/-/media/SaudiaWebApp/data/media/img/Alfursan/partners/hotel-partners/20220126-alfursan-partners--rotana-ar-fixed2.ashx?h=350&amp;iar=0&amp;w=1920&amp;rev=d7a39042c7fd44ba9a4bb84a576d876c&amp;hash=92A4023AF2443D2938099F1568F08D36\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"d82af6fe-40cc-4d42-9d6f-dacfff1cd746\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><h1 appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">Rotana</span><!----></h1><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n<div class=\"container main-content details-page\">\n<div class=\"col-12 field-section1\">\n<h2 class=\"fs-1-5 vg-0--top\">Rotana</h2>\n<p>\nEnjoy stays at any of Rotana’s hotels and resorts across the most exotic destinations in the Middle East, Africa, Eastern Europe and Türkiye. Explore splendid locations with exclusive dining, conference and banqueting in addition to leisure and fitness facilities combined with lots of Miles.\n</p>\n<a href=\"https://www.rotana.com/\" class=\"saudia-btn saudia-btn--primary\" target=\"_blank\" rel=\"noopener noreferrer\">\nBook Now\n</a>\n<h3 class=\"saudia-h3-spacing fs-1-3\">Benefits</h3>\n<p>\nALFURSAN Members are entitled up to 1500 reward miles depending on the room category:\n</p>\n<ul class=\"saudia-list saudia-list--unordered\">\n    <li>Standard: 500</li>\n    <li>Executive / Club Rotana: 1,000</li>\n    <li>Suite: 1,500</li>\n</ul>\n<h3 class=\"saudia-h3-spacing fs-1-3\">Terms &amp; Conditions</h3>\n<ul class=\"saudia-list saudia-list--unordered\">\n    <li>Booking must be in the name of the ALFURSAN member.</li>\n    <li>\n    Quote your ALFURSAN membership number upon reservation and present your ALFURSAN card or digital card at the time of check-in.\n    </li>\n    <li>\n    Miles are earned per stay*, regardless of the number of nights booked, for a maximum of 3 rooms.\n    </li>\n    <li>\n    *Eligible Stay refers to any stay that is booked at a published rate except for tour operators, travel industry and complimentary / barter rates.\n    </li>\n</ul>\n<p>\n*Stays at The Residences by Rotana are not eligible to earn Miles.\n</p>\n<p>\n**Please allow 4 - 8 weeks from the check-out date for mileage posting, provided that the membership number has been obtained.\n</p>\n<h3 class=\"saudia-h3-spacing fs-1-3\">To Claim Your Missing Miles</h3>\n<p>\nForgot to mention your ALFURSAN membership number upon check-in, email our partner at\n<a href=\"mailto:support.rewards@rotana.com\">support.rewards@rotana.com</a>\nand claim your missing miles for your stay at Rotana hotels and resorts.\n</p>\n<p>\nProvide the details of your stay. Claims may be made within a 6-month period from the check-out date.\n</p>\n<h3 class=\"saudia-h3-spacing fs-1-3\">For more details and bookings</h3>\n<p>\nPlease visit\n<a href=\"https://www.rotana.com/\" target=\"_blank\" rel=\"noopener noreferrer\">\nRotana Hotels and Resorts • Hotels in the Middle East, Africa, Eastern Europe &amp; Türkiye\n</a>\n</p>\n</div>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}