lesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n\n<div class=\"sa-fleet-grid\">\n\n  <div class=\"sa-fleet-row\">\n    \n    <div class=\"sa-fleet-card\">\n      <a class=\"sa-fleet-card__link\" href=\"https://entertainment.saudia.com/cabin-classes\" aria-label=\"Discover flying in First Suite\">\n        <div class=\"sa-fleet-card__media\">\n          <img alt=\"Saudia First Suite cabin\" src=\"/-/media/SaudiaWebApp/data/media/img/cabin-classes/FirstSuite02.ashx?rev=bdfa8f26f1d44684bfd290dbd15c6fd5&amp;hash=534C0170B28556128097BE4243B95CEF\">\n          <div class=\"sa-fleet-card__overlay\">\n            <h4 class=\"sa-fleet-card__title\">First Suite</h4>\n          </div>\n        </div>\n        <div class=\"sa-fleet-card__content\">\n          <p class=\"sa-fleet-card__desc\">Step in and make yourself comfortable at home.</p>\n          <span class=\"sa-fleet-card__cta\">Discover flying in First Suite</span>\n        </div>\n      </a>\n    </div>\n\n    <div class=\"sa-fleet-card\">\n      <a class=\"sa-fleet-card__link\" href=\"https://entertainment.saudia.com/cabin-classes\" aria-label=\"Discover flying in Business Class\">\n        <div class=\"sa-fleet-card__media\">\n          <img alt=\"Saudia Business Class seats\" src=\"/-/media/SaudiaWebApp/data/media/img/cabin-classes/Business02.ashx?rev=950b1a12ceb740f4962277fef490bb40&amp;hash=32562FAC9E9C4CF62F5FA4BDF8167E22\">\n          <div class=\"sa-fleet-card__overlay\">\n            <h4 class=\"sa-fleet-card__title\">Business Class</h4>\n          </div>\n        </div>\n        <div class=\"sa-fleet-card__content\">\n          <p class=\"sa-fleet-card__desc\">Relax or catch up on work with our uniquely designed seat.</p>\n          <span class=\"sa-fleet-card__cta\">Discover flying in Business Class</span>\n        </div>\n      </a>\n    </div>\n\n    <div class=\"sa-fleet-card\">\n      <a class=\"sa-fleet-card__link\" href=\"https://entertainment.saudia.com/cabin-classes\" aria-label=\"Discover flying in Guest Class\">\n        <div class=\"sa-fleet-card__media\">\n          <img alt=\"Saudia Guest Class cabin\" src=\"/-/media/SaudiaWebApp/data/media/img/cabin-classes/Guest_02.ashx?rev=d572e351db474c5aacca915ec4b33823&amp;hash=0181B885F25B125D457AF7386F33134E\">\n          <div class=\"sa-fleet-card__overlay\">\n            <h4 class=\"sa-fleet-card__title\">Guest Class</h4>\n          </div>\n        </div>\n        <div class=\"sa-fleet-card__content\">\n          <p class=\"sa-fleet-card__desc\">Enjoy personal space and comfort on your journey.</p>\n          <span class=\"sa-fleet-card__cta\">Discover flying in Guest Class</span>\n        </div>\n      </a>\n    </div>\n\n  </div>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}