ia-selected=\"false\" aria-disabled=\"false\"><div class=\"mat-tab-label-content\">Miles<!----><!----><!----></div></div><div role=\"tab\" mattablabelwrapper=\"\" mat-ripple=\"\" cdkmonitorelementfocus=\"\" class=\"mat-ripple mat-tab-label mat-focus-indicator ng-star-inserted\" id=\"mat-tab-label-0-4\" tabindex=\"-1\" aria-posinset=\"5\" aria-setsize=\"5\" aria-controls=\"mat-tab-content-0-4\" aria-selected=\"false\" aria-disabled=\"false\"><div class=\"mat-tab-label-content\">Gamification<!----><!----><!----></div></div><!----></div><mat-ink-bar class=\"mat-ink-bar\"></mat-ink-bar></div></div><button aria-hidden=\"false\" type=\"button\" mat-ripple=\"\" tabindex=\"0\" class=\"mat-ripple mat-tab-header-pagination mat-tab-header-pagination-after mat-elevation-z4 mat-tab-header-pagination-disabled\" disabled=\"\" role=\"button\" aria-label=\"Next slide\"><div class=\"mat-tab-header-pagination-chevron\"></div></button></mat-tab-header><div class=\"mat-tab-body-wrapper\"><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-26 mat-tab-body-active ng-star-inserted\" id=\"mat-tab-content-0-0\" aria-labelledby=\"mat-tab-label-0-0\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-26 ng-trigger ng-trigger-translateTab\"><!----><div class=\"ng-star-inserted\"><p appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\"><!-- SECTION START -->\n<section id=\"af-cards\" data-af-cards=\"\" aria-label=\"AlFursan features\">\n\n  <p class=\"af-desc\">Everything related to joining, accessing, and managing your AlFursan account.</p>\n\n  <br>\n\n  <ul class=\"af-list\">\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/Sign-up-v2.ashx?rev=b75f7b0fa9054d51b6719be44cd30255&amp;hash=C41E23E377D0AF45C538B71DE99C73A8\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Sign-Up</h3>\n        <p class=\"af-desc\">Join AlFursan seamlessly to enjoy exclusive benefits, earn bonus Miles from your very first flight, and unlock more rewarding journeys.</p>\n      </div>\n      <div class=\"af-cta\">\n        <a href=\"https://www.saudia.com/en-SA/Register\" class=\"af-btn\">Join now</a>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/login.ashx?rev=d3cb6e26a2f440588697f4bd21208c4a&amp;hash=DD83688FB34BFC5C56CB71EC47764F6E\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Login</h3>\n        <p class=\"af-desc\">Access your AlFursan account securely anytime and enjoy your digital experience. </p>\n      </div>\n      <div class=\"af-cta\">\n        <a href=\"https://www.saudia.com/en-SA/socialLogin\" class=\"af-btn\">Login now</a>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/social-login.ashx?rev=1bc6c990a0754fa3a9a28d85b817fca1&amp;hash=F7D39CE0A38ADD48BAC807A5868B8F90\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Social Login</h3>\n        <p class=\"af-desc\">Sign up or log in with a single tap using your Apple or Google account. The fastest, most secure way to access your AlFursan experince.</p>\n      </div>\n      <div class=\"af-cta\">\n        <a href=\"https://www.saudia.com/en-SA/socialLogin\" class=\"af-btn\">Login Socialy now</a>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/activate-email.ashx?rev=6dc137ab22bc4dcf9610810258ae37a4&amp;hash=06A09C89C8FE98A07A40F3BD5090C5A4\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Activate Email</h3>\n        <p class=\"af-desc\">Activate your email anytime, anywhere, and enjoy immediate access to your AlFursan benefits and updates.</p>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/forget-alfursan-id.ashx?rev=c7d6603de7084958a974902beed69a1a&amp;hash=12F8A877390AA4088A490BA5A668326A\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Forgot AlFursan ID</h3>\n        <p class=\"af-desc\">Retrieve it instantly online in just two steps.</p>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/forgot-alfursan-password.ashx?rev=6292e61900564eb0956908440561870f&amp;hash=9A96F907587B27380515838271899996\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Forget Password</h3>\n        <p class=\"af-desc\">Reset your password in seconds. </p>\n      </div>\n    </li>\n\n    <li class=\"af-item\">\n      <div class=\"af-media\">\n        <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/manage-profile.ashx?rev=175e9b680c2b47b6b4ad086153bfc96b&amp;hash=7D01FAFA67E1928F5C7D9C6E8E2308EB\" alt=\"\">\n      </div>\n      <div class=\"af-content\">\n        <h3 class=\"af-title\">Manage Profile</h3>\n        <p class=\"af-desc\">Update your information details, preferences, and communication settings all in one place.</p>\n      </div>\n    </li>\n\n  </ul>\n</section>\n<!-- ✅ SECTION END -->\n\n\n</span><!----></p><!----></div><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-27 ng-star-inserted\" id=\"mat-tab-content-0-1\" aria-labelledby=\"mat-tab-label-0-1\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-27 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-28 ng-star-inserted\" id=\"mat-tab-content-0-2\" aria-labelledby=\"mat-tab-label-0-2\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-28 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-29 ng-star-inserted\" id=\"mat-tab-content-0-3\" aria-labelledby=\"mat-tab-label-0-3\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-29 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-30 ng-star-inserted\" id=\"mat-tab-content-0-4\" aria-labelledby=\"mat-tab-label-0-4\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-30 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><!----></div></mat-tab-group><!----></div></app-jss-tabs><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}