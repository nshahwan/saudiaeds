"hero-alfursan-layout\">\n\n        <!-- النص -->\n        <div class=\"hero-alfursan-copy\">\n\n          <!-- لوقو موبايل -->\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/alfursan-compelete-digital/alfursan-full-digital/alfursan_logo-en.ashx?rev=6e9699038ea647b2be2094ce29f5c671&amp;hash=256C18EE4D641492F56E3A923F208F59\" class=\"hero-alfursan-logo-mobile\" alt=\"Saudia AlFursan\">\n\n          <h1 class=\"hero-alfursan-title\">\n            A complete digital experience<br>with AlFursan\n          </h1>\n\n          <p class=\"hero-alfursan-sub\">\n            All your services are now available online through Saudia app or website,\n            for an experience that lasts ForLife.\n          </p>\n\n          <div class=\"hero-alfursan-cta\">\n            <a href=\"https://www.saudia.com/en-SA/socialLogin\" class=\"hero-alfursan-btn hero-alfursan-btn-primary\">Login</a>\n            \n            \n            <span class=\"hero-alfursan-cta-or\">or</span>\n            <a href=\"https://www.saudia.com/en-SA/Register\" class=\"hero-alfursan-btn hero-alfursan-btn-secondary\">Join AlFursan</a>\n          </div>\n\n        </div>\n\n        <!-- صورة الجوال -->\n        <div class=\"hero-alfursan-media\" aria-hidden=\"true\">\n          \n        </div>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n\n</p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container container--horizontal\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-tabs class=\"ng-star-inserted\"><div class=\"cms-tab-container\"><mat-tab-group animationduration=\"0ms\" class=\"mat-tab-group mat-primary ng-star-inser