----></div></div><!----><!----></app-jss-columns><app-jss-columns class=\"ng-star-inserted\"><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row ng-star-inserted\"><div class=\"flex-col ng-star-inserted\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-faq class=\"ng-star-inserted\"><div class=\"faq-section ng-star-inserted\"><div class=\"container\"><div fxlayout=\"row\" fxlayout.lt-lg=\"column\" fxlayoutgap=\"20px grid\" fxlayoutgap.gt-lg=\"24px grid\"><div fxflex.gt-lg=\"50\" class=\"faq__title\"><h2 class=\"primary-heading ng-star-inserted\" aria-label=\"\">Frequently asked questions</h2><!----><div class=\"all-faqs ng-star-inserted\"><a id=\"viewAllFaq\" class=\"faq_link_button ng-star-inserted\" target=\"_self\" href=\"/en-SA/Support/HelpAndSupport/FAQs\n                  \" aria-label=\"View all Frequently Asked Questions\"><span> View all FAQs </span><span aria-hidden=\"true\" class=\"material-icons-outlined faq_icon icon-Link_chevron\"> chevron_right </span></a><!----></div><!----></div><div fxflex.gt-lg=\"50\"><mat-accordion class=\"mat-accordion faq__accordion\"><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-54 mat-expanded mat-expansion-panel-spacing ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-55 ng-tns-c1859850774-54 ng-animate-disabled mat-expanded mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"How to redeem your Miles?\" id=\"mat-expansion-panel-header-18\" aria-controls=\"cdk-accordion-child-18\" aria-expanded=\"true\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-55\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-55\"> How to redeem your Miles? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-55 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-54 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-18\" aria-labelledby=\"mat-expansion-panel-header-18\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-54\"><p class=\"mat-panel-body-custom ng-star-inserted\">Miles can be redeemed online. Sign into your AlFursan account and select 'Redeem Miles'. Alternatively you can redeem Rewards through the Saudia Guest Care Center.\n<br>\n<span class=\"iframe-video\" data-src=\"https://www.youtube.com/embed/FBuuJ8c-Wbk?list=PLs1ZzkrzY9N3G0ckKqr4bBF59ZdIcbdC7\" tabindex=\"0\" role=\"button\" href=\"javascript:void(0)\"><span class=\"material-icons-outlined play-icon\" aria-hidden=\"true\">play_circle</span><span class=\"watch-video\">Watch Video</span></span></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-56 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-57 ng-tns-c1859850774-56 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"How can I upgrade my booking using Miles?\" id=\"mat-expansion-panel-header-19\" aria-controls=\"cdk-accordion-child-19\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-57\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-57\"> How can I upgrade my booking using Miles? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-57 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-56 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-19\" aria-labelledby=\"mat-expansion-panel-header-19\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-56\"><p class=\"mat-panel-body-custom ng-star-inserted\">You can easily upgrade your seat online by managing your booking and using your AlFursan Miles.\n<br>\n<br>\n<a href=\"https://www.saudia.com/upgrade-by-miles\">learn more</a> <br>\n<!-----\n<span class=\"iframe-video\" data-src=\"https://www.youtube.com/embed/cPF5TxA95wU?list=PLs1ZzkrzY9N3G0ckKqr4bBF59ZdIcbdC7\"><span class=\"material-icons-outlined play-icon\">play_circle</span><span class=\"watch-video\">Watch Video</span></span>\n\n-------></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-58 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-59 ng-tns-c1859850774-58 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"How to add a family member to your account? \" id=\"mat-expansion-panel-header-20\" aria-controls=\"cdk-accordion-child-20\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-59\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-59\"> How to add a family member to your account?  </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-59 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-58 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-20\" aria-labelledby=\"mat-expansion-panel-header-20\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-58\"><p class=\"mat-panel-body-custom ng-star-inserted\"><p>To enroll family members, you have to be the head of the Family program and then follow the below steps:</p>\n<ol>\n    <li>Log into your profile</li>\n    <li>Choose the family program section</li>\n    <li>Click on \"manage my family program\"</li>\n    <li>Click on \"add member\"</li>\n    <li>You have two options (Adding a child or adding an adult)</li>\n</ol>\n<p>* Child: Has to be 2-12 years old.Fill the mandatory field(s) to enroll a new child on the program</p>\n<p>* Adult: Has to be an existing member of AlFursan.</p>\n<ol>\n    <li>Fill the mandatory fields</li>\n    <li>Click on the send button</li>\n    <li>The request will be reviewed by the Guest Call Center. If all the information is correct, they will submit an invitation to the invited member</li>\n    <li>The invited member will accept the invitation</li>\n</ol>\n<br>\n<div class=\"iframe-video\" id=\"video2\" data-src=\"https://www.youtube.com/embed/I2ymgPvhSYg?list=PLs1ZzkrzY9N3G0ckKqr4bBF59ZdIcbdC7\" tabindex=\"0\" role=\"button\" href=\"javascript:void(0)\"><span class=\"material-icons-outlined\" aria-hidden=\"true\">play_circle</span><span>Watch Video</span></div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-60 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-61 ng-tns-c1859850774-60 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"How to claim missing Miles?\" id=\"mat-expansion-panel-header-21\" aria-controls=\"cdk-accordion-child-21\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-61\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-61\"> How to claim missing Miles? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-61 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-60 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-21\" aria-labelledby=\"mat-expansion-panel-header-21\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-60\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ol>\n    <li>Log into your AlFursan profile</li>\n    <li>Choose the Miles claim section</li>\n    <li>Fill the mandatory fields</li>\n    <li>Submit the claim</li>\n</ol>\n<br></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-62 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-63 ng-tns-c1859850774-62 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"How to Manage My Reward Ticket?\" id=\"mat-expansion-panel-header-22\" aria-controls=\"cdk-accordion-child-22\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-63\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-63\"> How to Manage My Reward Ticket? </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-63 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-62 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-22\" aria-labelledby=\"mat-expansion-panel-header-22\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-62\"><p class=\"mat-panel-body-custom ng-star-inserted\">Through <a href=\"https://www.saudia.com/\">www.saudia.com</a>, under 'manage', insert your booking reference and last name. Then log in with your frequent flyer program to be able to manage your reward tickets booked with Miles.\n<br>\n<br>\n<a href=\"https://www.saudia.com/\">learn more</a> <br>\n<!---\n<span class=\"iframe-video\" data-src=\"https://www.youtube.com/embed/cPF5TxA95wU?list=PLs1ZzkrzY9N3G0ckKqr4bBF59ZdIcbdC7\"><span class=\"material-icons-outlined play-icon\">play_circle</span><span class=\"watch-video\">Watch Video</span></span>\n----></p><!----><!----></div></div></mat-expansion-panel><!----><!----></mat-accordion></div></div></div></div><!----></app-jss-faq><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns class=\"ng-star-inserted\"><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row ng-star-inserted\"><div class=\"flex-col ng-star-inserted\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder><!----></section><!----></app-dashboard><app-jss-columns class=\"ng-star-inserted\"><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row ng-star-inserted\"><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns class=\"ng-star-inserted\"><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row ng-star-inserted\"><div class=\"flex-col ng-star-inserted\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}