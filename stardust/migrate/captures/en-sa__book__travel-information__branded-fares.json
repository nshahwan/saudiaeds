') -->\n      <label for=\"acc-none\" class=\"acc-summary acc-close\" aria-controls=\"acc-guest-panel\" aria-expanded=\"true\">\n        <div class=\"fare-card-title\">Guest Class</div>\n      </label>\n    </div>\n\n    <div id=\"acc-guest-panel\" class=\"acc-panel\" aria-hidden=\"true\">\n      <div class=\"acc-inner\">\n        <div class=\"fare-table-wrapper\">\n          <table class=\"fare-table\" aria-label=\"Guest Class Fare Benefits\">\n            <thead>\n              <tr>\n                <th>Service</th>\n                <th>Guest Saver</th>\n                <th>Guest Basic</th>\n               <th>Guest Semi Flex</th>\n                <th>Guest Flex</th>\n              </tr>\n            </thead>\n            <tbody>\n              <!--<tr><td>Cabin Baggage</td><td>1pc x 7 kg</td><td>1pc x 7 kg</td><td>1pc x 7 kg</td><td>1pc x 7 kg</td></tr>\n              <tr><td>Checked Baggage</td><td>Not permitted</td><td>1pc x 23 kg</td><td>1pc x 23 kg</td><td>2pc x 23 kg</td></tr>-->\n              <tr><td>Seat Selection (Standard Seat)</td><td>Fee applies</td><td>Fee applies</td><td>Free**</td><td>Free**</td></tr>\n              <tr><td>Seat Selection (Preferred Seat)</td><td>Fee applies</td><td>Fee applies</td><td>Fee applies**</td><td>Free**</td></tr>\n              <tr><td>AlFursan Miles</td><td>0</td><td>60%</td><td>80%</td><td>110%</td></tr>\n              <tr><td>Upgrade With Miles</td><td>Not permitted</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Upgrade Bidding Eligibility</td><td>Not permitted</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Cash Upgrade Eligibility</td><td>Not permitted</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Cancellation</td><td>Not permitted</td><td>Fee applies*</td><td>Fee applies</td><td>Fee applies</td></tr>\n              <tr><td>Flight Change</td><td>Not permitted</td><td>Fee applies</td><td>Fee applies</td><td>Free</td></tr>\n              <tr><td>No-Show</td><td>Not permitted</td><td>Fee applies</td><td>Fee applies</td><td>Fee applies</td></tr>\n            </tbody>\n          </table>\n          <div class=\"fare-card-subtitle\">** Leg-Room and Emergency seats are not included.</div>\n          <!--<div class=\"fare-card-subtitle\">Checked baggage piece weight Guest Class: 23kg per piece.</div>-->\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Business Class -->\n  <section class=\"fare-card\" role=\"region\" aria-labelledby=\"acc-biz-label\">\n    <input type=\"radio\" name=\"fare-acc\" id=\"acc-biz\" class=\"acc-toggle\">\n\n    <div class=\"acc-header\">\n      <label for=\"acc-biz\" id=\"acc-biz-label\" class=\"acc-summary acc-open\" aria-controls=\"acc-biz-panel\" aria-expanded=\"false\">\n        <div class=\"fare-card-title\">Business Class</div>\n      </label>\n      <label for=\"acc-none\" class=\"acc-summary acc-close\" aria-controls=\"acc-biz-panel\" aria-expanded=\"true\">\n        <div class=\"fare-card-title\">Business Class</div>\n      </label>\n    </div>\n\n    <div id=\"acc-biz-panel\" class=\"acc-panel\" aria-hidden=\"true\">\n      <div class=\"acc-inner\">\n        <div class=\"fare-table-wrapper\">\n          <table class=\"fare-table\" aria-label=\"Business Class Fare Benefits\">\n            <thead>\n              <tr>\n                <th>Service</th>\n                <th>Business Basic</th>\n                <th>Business Semi Flex</th>\n                <th>Business Flex</th>\n              </tr>\n            </thead>\n            <tbody>\n              <!--<tr><td>Cabin Baggage</td><td>2pc ***</td><td>2pc ***</td><td>2pc ***</td></tr>\n              <tr><td>Checked Baggage</td><td>1pc x 32 kg</td><td>2pc x 32 kg</td><td>2pc x 32 kg</td></tr>-->\n              <tr><td>Seat Selection</td><td>Free</td><td>Free</td><td>Free</td></tr>\n              <tr><td>AlFursan Miles</td><td>175%</td><td>225%</td><td>250%</td></tr>\n              <tr><td>Upgrade With Miles</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Lounge Access</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Fast Track</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Upgrade Bidding Eligibility</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Cash Upgrade Eligibility</td><td>Permitted</td><td>Permitted</td><td>Permitted</td></tr>\n              <tr><td>Cancellation</td><td>Fee applies</td><td>Fee applies</td><td>Free</td></tr>\n              <tr><td>Flight Change</td><td>Fee applies</td><td>Fee applies</td><td>Free</td></tr>\n              <tr><td>No-Show</td><td>Fee applies</td><td>Fee applies</td><td>Fee applies</td></tr>\n            </tbody>\n          </table>\n          <!--<div class=\"fare-card-subtitle\">*** Cabin Baggage piece weight: One piece ≤ 12 kg + a briefcase ≤ 9 kg.</div>\n          <div class=\"fare-card-subtitle\">Checked baggage piece weight Business Class: 32kg per piece.</div>-->\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- First Class -->\n  <section class=\"fare-card\" role=\"region\" aria-labelledby=\"acc-first-label\">\n    <input type=\"radio\" name=\"fare-acc\" id=\"acc-first\" class=\"acc-toggle\">\n\n    <div class=\"acc-header\">\n      <label for=\"acc-first\" id=\"acc-first-label\" class=\"acc-summary acc-open\" aria-controls=\"acc-first-panel\" aria-expanded=\"false\">\n        <div class=\"fare-card-title\">First Class</div>\n      </label>\n      <label for=\"acc-none\" class=\"acc-summary acc-close\" aria-controls=\"acc-first-panel\" aria-expanded=\"true\">\n        <div class=\"fare-card-title\">First Class</div>\n      </label>\n    </div>\n\n    <div id=\"acc-first-panel\" class=\"acc-panel\" aria-hidden=\"true\">\n      <div class=\"acc-inner\">\n        <div class=\"fare-table-wrapper\">\n          <table class=\"fare-table\" aria-label=\"First Class Fare Benefits\">\n            <thead>\n              <tr>\n                <th>Service</th>\n                <th>First Flex</th>\n              </tr>\n            </thead>\n            <tbody>\n              <!--<tr><td>Cabin Baggage</td><td>2pc ***</td></tr>\n              <tr><td>Checked Baggage</td><td>2pc x 32 kg</td></tr>-->\n              <tr><td>Seat Selection</td><td>Free</td></tr>\n              <tr><td>AlFursan Miles</td><td>350%</td></tr>\n              <tr><td>Upgrade With Miles</td><td>-</td></tr>\n              <tr><td>Lounge Access</td><td>Permitted</td></tr>\n              <tr><td>Fast Track</td><td>Permitted</td></tr>\n              <tr><td>Upgrade Bidding Eligibility</td><td>-</td></tr>\n              <tr><td>Cash Upgrade Eligibility</td><td>-</td></tr>\n              <tr><td>Cancellation</td><td>Free</td></tr>\n              <tr><td>Flight Change</td><td>Free</td></tr>\n              <tr><td>No-Show</td><td>Fee applies</td></tr>\n            </tbody>\n          </table>\n          <!--<div class=\"fare-card-subtitle\">*** Cabin Baggage piece weight: One piece ≤ 12 kg + a briefcase ≤ 9 kg.</div>\n          <div class=\"fare-card-subtitle\">Checked baggage piece weight First Class: 32kg per piece.</div>-->\n        </div>\n      </div>\n    </div>\n  </section>\n\n</div></span><!----></p><!----></div><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-20 ng-star-inserted\" id=\"mat-tab-content-0-1\" aria-labelledby=\"mat-tab-label-0-1\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-20 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-21 ng-star-inserted\" id=\"mat-tab-content-0-2\" aria-labelledby=\"mat-tab-label-0-2\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-21 ng-trigger ng-trigger-translateTab\"><!----></div></mat