{"url":"https://www.saudia.com/en-SA/book-and-manage/book/travel-insurance","status":200,"title":"Air Travel Insurance Coverage and Benefits | Saudia","desc":"Protect your trip with Saudia air travel insurance. Explore coverage options for delays, cancellations and medical needs. Add travel insurance to your booking with Saudia today.","finalUrl":"https://www.saudia.com/en-SA/book-and-manage/book/travel-insurance","bodyClass":"baseLang mWebHomePage white-theme","h":4428,"sig":[{"tag":"app-jss-columns","comps":["app-jss-image-link-list"],"h":600,"headings":1,"imgs":1,"text":49},{"tag":"app-jss-columns","comps":["app-jss-saudia-general-tablayout","app-jss-saudia-general-tab","app-jss-manage"],"h":73,"headings":0,"imgs":0,"text":137},{"tag":"app-jss-columns","comps":["app-jss-title-text"],"h":680,"headings":1,"imgs":0,"text":1178},{"tag":"app-jss-columns","comps":["app-jss-image-link-list"],"h":492,"headings":1,"imgs":1,"text":140},{"tag":"app-jss-columns","comps":["app-jss-faq"],"h":1083,"headings":1,"imgs":0,"text":2729}],"h1":["Air Travel Insurance Coverage and Benefits | Saudia","Travel insurance"],"html":"<sc-placeholder _ngcontent-saudiawebapp-c260489156=\"\" name=\"jss-main\"><!----><app-jss-columns><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-image-link-list class=\"ng-star-inserted\"><div class=\"custom-carousel imagelinklist--content-embedded h--left v--top image--slider ng-star-inserted\"><!----><div appswiper=\"\" fxflex=\"auto\" class=\"swiper-container ng-star-inserted swiper-initialized swiper-horizontal swiper-backface-hidden\"><div class=\"swiper-wrapper\"><div class=\"swiper-slide ng-star-inserted swiper-slide-active\"><div fxlayout=\"column\" fxlayoutalign=\"\" fxflexfill=\"\"><div aria-hidden=\"true\" class=\"swiper-slide__image