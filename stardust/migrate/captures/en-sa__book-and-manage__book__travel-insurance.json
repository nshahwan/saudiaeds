mat-form-field-label-3\" for=\"mat-input-1\" aria-owns=\"mat-input-1\"><!----><mat-label class=\"manage-booking__label ng-tns-c2842056177-26 ng-star-inserted\">Last name </mat-label><!----><!----><span aria-hidden=\"true\" class=\"mat-placeholder-required mat-form-field-required-marker ng-tns-c2842056177-26 ng-star-inserted\"> *</span><!----></label><!----></span></div><div class=\"mat-form-field-suffix ng-tns-c2842056177-26 ng-star-inserted\"><div matsuffix=\"\" class=\"ng-tns-c2842056177-26\"><span aria-hidden=\"true\" class=\"material-icons-outlined manage-profile-image ng-star-inserted\"> person_outline </span><!----><!----><!----></div></div><!----></div><div class=\"mat-form-field-underline ng-tns-c2842056177-26 ng-star-inserted\"><span class=\"mat-form-field-ripple ng-tns-c2842056177-26\"></span></div><!----><div class=\"mat-form-field-subscript-wrapper ng-tns-c2842056177-26\"><!----><div class=\"mat-form-field-hint-wrapper ng-tns-c2842056177-26 ng-trigger ng-trigger-transitionMessages ng-star-inserted\"><!----><div class=\"mat-form-field-hint-spacer ng-tns-c2842056177-26\"></div></div><!----></div></div></mat-form-field></div><!----></div></div><!----><!----></div></form><!----></app-jss-manage><!----></sc-placeholder></div></app-jss-saudia-general-tab><!----></sc-render-component>\n            </div>\n          <!----></div></mat-tab-body><!----></div></mat-tab-group><sc-placeholder name=\"jssAncillaryLinks\"><!----><!----></sc-placeholder><sc-placeholder name=\"jssNotificationInfo\"><!----><!----></sc-placeholder><div tabindex=\"0\" role=\"button\" class=\"custom-overlay-close ng-star-inserted\"><span class=\"material-icons icon-close-outlined close\">close</span></div><!----></div></div><!----></app-jss-saudia-general-tablayout><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\"><div class=\"custom-content__wrapper\">\n<div class=\"container\">\n<p>The travel insurance service is one of the unique offerings provided by Saudia to its valued guests, aiming to deliver the best travel experience in collaboration with Al Rajhi Takaful, one of the leading insurance companies in the Kingdom of Saudi Arabia, committed to offering various innovative products and services in compliance with Islamic Shariah law.<br>\n<br>\nThe travel insurance service aims to provide diverse insurance solutions and services to enhance and improve the experience of our esteemed guests, offering a variety of benefits, including the following:&nbsp;</p>\n<ul>\n    <li>Compensation for trip cancellation up to 20,000 SAR</li>\n    <li>Compensation for flight delays at 100 SAR per hour, up to 2,000 SAR</li>\n    <li>Compensation for emergency medical expenses up to 3,750,000 SAR, including COVID-19 coverage</li>\n    <li>Compensation for baggage delay at 100 SAR per hour, up to 2,000 SAR</li>\n    <li>Compensation for legal liability up to 1,000,000 SAR</li>\n    <li>Personal belongings coverage up to 10,000 SAR</li>\n    <li>Personal accident benefits</li>\n    <li>And other benefits</li>\n</ul>\n<h2>Where to Request the Service</h2>\n<p>Guests can request this service during the booking process through our digital channels from the additional services page or through the manage bookings page.&nbsp;</p>\n</div>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-image-link-list class=\"ng-star-inserted\"><div class=\"custom-carousel imagelinklist--content-embedded h--right v--center imagelinklist-icon--rectangle image--teaser mobile-text--center saudia-adventure ng-star-inserted\"><!----><div appswiper=\"\" fxflex=\"auto\" class=\"swiper-container ng-star-inserted swiper-initialized swiper-horizontal swiper-backface-hidden\"><div class=\"swiper-wrapper\"><div class=\"swiper-slide ng-star-inserted swiper-slide-active\"><div fxlayout=\"column\" fxlayoutalign=\"\" fxflexfill=\"\"><div aria-hidden=\"true\" class=\"swiper-slide__image desktop-view ng-star-inserted\"><img fetchpriority=\"high\" alt=\"Upgrade With Miles\" width=\"1200\" height=\"372\" src=\"/-/media/SaudiaWebApp/data/media/img/Teasers/DesktopTeaser/UpgradewithMiles-Web.ashx?h=372&amp;iar=0&amp;w=1200&amp;rev=8d1ee0b12e5c4c778b3d93226a164870&amp;hash=7E04F40539BBAFA9507EEB1090F5D5AC\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"0eea35b3-a48c-4f68-98f2-55cbe88dd8e7\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><!----><h2 appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">Explore the beauty of the Kingdom</span><!----></h2><!----><!----><!----><!----><!----><!----><div appexcerpttext=\"\" class=\"swiper-slide__desc ng-star-inserted\"><span class=\"ng-star-inserted\">Want to visit Saudi Arabia? Register for your e-Visa on the Visit Saudi platform.</span><!----></div><!----><div class=\"swiper-slide__button ng-star-inserted\"><a role=\"link\" mat-button=\"\" class=\"mat-focus-indicator button button--icon-text mat-button mat-button-base button--tertiary\" href=\"/en-SA/transit-visa\" target=\"_self\" aria-label=\"\" aria-disabled=\"false\"><span class=\"mat-button-wrapper\"><span appexcerpttext=\"\" class=\"ng-star-inserted\">Register now</span><!----><span aria-hidden=\"true\" class=\"material-icons-outlined icon-arrow_forward-outlined ng-star-inserted\"> arrow_forward </span><!----></span><span matripple=\"\" class=\"mat-ripple mat-button-ripple\"></span><span class=\"mat-button-focus-overlay\"></span></a></div><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-faq class=\"ng-star-inserted\"><div class=\"faq-section ng-star-inserted\"><div class=\"container\"><div fxlayout=\"row\" fxlayout.lt-lg=\"column\" fxlayoutgap=\"20px grid\" fxlayoutgap.gt-lg=\"24px grid\"><div fxflex.gt-lg=\"50\" class=\"faq__title\"><h2 class=\"primary-heading ng-star-inserted\" aria-label=\"\">About Travel Insurance</h2><!----><!----></div><div fxflex.gt-lg=\"50\"><mat-accordion class=\"mat-accordion faq__accordion\"><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-1 mat-expanded mat-expansion-panel-spacing ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-2 ng-tns-c1859850774-1 ng-animate-disabled mat-expanded mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Travel Insurance Terms and Conditions\" id=\"mat-expansion-panel-header-0\" aria-controls=\"cdk-accordion-child-0\" aria-expanded=\"true\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-2\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-2\"> Travel Insurance Terms and Conditions </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-2 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-1 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-0\" aria-labelledby=\"mat-expansion-panel-header-0\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-1\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n    <li>The service is offered on flights departing from the Kingdom of Saudi Arabia only to all countries worldwide (one-way/round-trip).</li>\n<li>The duration of any international round-trip journey shall not exceed ninety-two (92) consecutive days between the outbound and return flights. The duration of any domestic round-trip journey shall not exceed thirty (30) consecutive days between the outbound and return flights.</li>\n    <li>The service is available only to Saudi citizens and holders of a resident ID (Iqama).</li>\n    <li>Coverage is provided 24 hours from passing through security at the arrival terminal for one-way tickets departing from the Kingdom only.</li>\n    <li>The covered flights are those that are purchased.</li>\n    <li>Coverage is limited to trips that were purchased and specified in the travel ticket at the time of policy purchase.</li>\n    <li>The guest’s age must not exceed 79 years.</li>\n    <li>Insurance can be utilized when rescheduling travel according to the following conditions:\n    <ol>\n        <li>It is permitted to modify the travel date for the same duration of stay by contacting Al Rajhi Takaful&nbsp;to update the date on the insurance policy without any additional fees. Contact with Al Rajhi Takaful&nbsp;must be made at least 24 hours before the scheduled trip.</li>\n        <li>The number of days specified in the purchased policy may be utilized in the event of an extended stay, with the option to purchase additional coverage for extra days, provided that the conditions outlined in the first clause are met.</li>\n        <li>If the stay duration is shortened, the insurance policy remains unaffected, and no refunds will be issued, in accordance with the first clause.</li>\n    </ol>\n    </li>\n    <li>This service is non-refundable, except in the event of trip disruption, and any refund shall be subject to Saudia's applicable policy.</li>\n    <li>Guests will be compensated for any claims made by the insured through Al Rajhi Takaful.</li>\n    <li>For assistance or inquiries related to the policy or insurance coverage, please contact Al Rajhi Takaful directly through the designated communication channels (email or telephone).</li>\n</ul></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-3 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-4 ng-tns-c1859850774-3 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Travel Insurance Exclusions\" id=\"mat-expansion-panel-header-1\" aria-controls=\"cdk-accordion-child-1\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-4\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-4\"> Travel Insurance Exclusions </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-4 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-3 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-1\" aria-labelledby=\"mat-expansion-panel-header-1\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-3\"><p class=\"mat-panel-body-custom ng-star-inserted\"><p>The following are excluded from coverage:</p>\n<ul>\n    <li>All pre-existing and chronic medical conditions of travelers.</li>\n    <li>Medical expenses that are not reported within 5 business days.</li>\n</ul></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-5 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-6 ng-tns-c1859850774-5 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Contacts\" id=\"mat-expansion-panel-header-2\" aria-controls=\"cdk-accordion-child-2\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-6\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-6\"> Contacts </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-6 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-5 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-2\" aria-labelledby=\"mat-expansion-panel-header-2\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-5\"><p class=\"mat-panel-body-custom ng-star-inserted\"><ul>\n    <li>To better serve you, contact us on:\n    &nbsp;    </li>\n</ul>\n\n<table width=\"100%\" class=\"table-wrapper2\">\n    <thead>\n    </thead>\n    <tbody>\n        <tr>\n            <td width=\"20%\" rowspan=\"2\">\n            Email</td>\n            <td>\n            General Claims&nbsp;            </td>\n            <td>&nbsp;<a href=\"mailto:generalclaims@alrajhitakaful.com\">generalclaims@alrajhitakaful.com</a></td>\n            <td>\n            For submitting claims or inquiries</td>\n        </tr>\n        <tr>\n            <td>\n            Customer Service Team</td>\n            <td>&nbsp;<a href=\"mailto:generalclaims@alrajhitakaful.com\">customerservice@alrajhitakaful.com</a></td>\n            <td>\n            For issues related to policy issuance or policy-related problems</td>\n        </tr>\n        <tr>\n            <td>\n            Phone</td>\n            <td colspan=\"2\">8001184444&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</td>\n            <td><br>\n            </td>\n        </tr>\n    </tbody>\n</table></p><!----><!----></div></div></mat-expansion-panel><!----><!----></mat-accordion></div></div></div></div><!----></app-jss-faq><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}