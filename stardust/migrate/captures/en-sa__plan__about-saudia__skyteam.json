{"url":"https://www.saudia.com/en-SA/plan/about-saudia/skyteam","status":200,"title":"SkyTeam","desc":null,"finalUrl":"https://www.saudia.com/en-SA/plan/about-saudia/skyteam","bodyClass":"white-theme cms-page lounge-page baseLang mWebHomePage","h":2326,"sig":[{"tag":"app-jss-columns","comps":["app-jss-title-text"],"h":268,"headings":0,"imgs":1,"text":911},{"tag":"app-jss-columns","comps":["app-jss-title-text"],"h":651,"headings":6,"imgs":0,"text":9661}],"h1":["SkyTeam","SkyTeam Alliance"],"html":"<sc-placeholder _ngcontent-saudiawebapp-c260489156=\"\" name=\"jss-main\"><!----><app-jss-columns><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-scripts class=\"ng-star-inserted\"></app-jss-scripts><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n<div class=\"background-div\">\n<picture>\n<source media=\"(max-width: 768px)\" srcset=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/skyteam/skyteam-header-mweb.ashx\"> <!-- Replace with your mobile image URL -->\n<img src=\"/-/media/SaudiaWebApp/data/media/img/Live-images/pages/skyteam/skyteam-header-web.ashx?rev=a60e54a82d1d4e00880a4c69a8a8bfc2&amp;hash=D17CB6120C3003614914CE156C49868D\" alt=\"Background Image\"> <!-- Replace with your desktop image URL -->\n</picture>\n<div class=\"gradient-overlay\">&nbsp;</div>\n<!-- Gradient overlay element -->\n<div class=\"overlay-div\">\n<!-- <h1 style=\"color:#ffffff;\">Ticketing</h1>-->\n<!--<p>Your one-stop platform with a host of self-services.</p>-->\n</div>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text-button class=\"ng-star-inserted\"><div class=\"cms-title-text-button-container ng-star-inserted\"><!----><!----><!----><div class=\"link--text\"><!----></div></div><!----><!----></app-jss-title-text-button><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n<div class=\"saudia-tab-layout js-tab-component\">\n<!-- Centered Main Title Above Sidebar and Content Area -->\n<h1 class=\"saudia-h1-centered\">SkyTeam Alliance</h1>\n<!-- Sidebar Navigation -->\n<aside class=\"saudia-tab-sidebar\">\n<ul class=\"saudia-tab-menu\" role=\"tablist\" aria-label=\"SkyTeam Alliance Information\">\n    <li class=\"saudia-tab-item\">\n    <button type=\"button\" class=\"saudia-tab-button js-tab-trigger is-active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"panel-overview\" id=\"tab-overview\">\n    Overview\n    </button>\n    </li>\n    <li class=\"saudia-tab-item\">\n    <button type=\"button\" class=\"saudia-tab-button js-tab-trigger\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-miles\" id=\"tab-miles\">\n   Earning and Redeeming Miles on SkyTeam Member Airlines\n    </button>\n    </li>\n    <li class=\"saudia-tab-item\">\n    <button type=\"button\" class=\"saudia-tab-button js-tab-trigger\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-lounges\" id=\"tab-lounges\">\n    Access to Airport Lounges Worldwide\n    </button>\n    </li>\n    <li class=\"saudia-tab-item\">\n    <button type=\"button\" class=\"saudia-tab-button js-tab-trigger\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-skypriority\" id=\"tab-skypriority\">\n   SkyTeam Priority Services (SkyPriority)\n    </button>\n    </li>\n    <li class=\"saudia-tab-item\">\n    <button type=\"button\" class=\"saudia-tab-button js-tab-trigger\" role=\"tab\" aria-selected=\"false\" aria-controls=\"panel-connections\" id=\"tab-connections\">\n    Guest Care and Assistance\n    </button>\n    </li>\n</ul>\n</aside>\n<!-- Main Content Area -->\n<main class=\"saudia-tab-content-area\">\n<!-- PANEL 1: OVERVIEW -->\n<section id=\"panel-overview\" class=\"saudia-tab-panel js-tab-panel is-active\" role=\"tabpanel\" aria-labelledby=\"tab-overview\">\n<div class=\"saudia-unified-container\">\n\n<h3 class=\"saudia-h3-spacing\">Overview</h3>\n\n<p class=\"saudia-lead-text\">\nSaudia and the global SkyTeam network enable members to travel around the world with greater benefits and enhanced convenience.\n</p>\n\n<p class=\"saudia-lead-text\">\nAs a member of the SkyTeam Alliance, Saudia provides a more connected and seamless global travel experience through integration with its alliance partners. Bringing together 19 leading airlines and connecting more than 1,000 destinations worldwide. SkyTeam helps members reach their final destinations with greater comfort and peace of mind.\n</p>\n\n<p class=\"saudia-lead-text\">\nWhether travelling for business or leisure, members can benefit from exclusive advantages, including priority services, lounge access for eligible guests, the ability to earn and redeem miles across all SkyTeam member airlines, integrated support throughout the journey, and smoother connections between alliance carriers.\n</p>\n\n</div>\n</section>\n<!-- PANEL 2: EARN & REDEEM MILES -->\n<section id=\"panel-miles\" class=\"saudia-tab-panel js-tab-panel\" role=\"tabpanel\" aria-labelledby=\"tab-miles\">\n<div class=\"saudia-unified-container\">\n\n<h3 class=\"saudia-h3-spacing\">Earning and Redeeming Miles on SkyTeam Member Airlines</h3>\n\n<p class=\"saudia-lead-text\">\nThrough its membership in the SkyTeam Alliance, Saudia enables Alfursan members to earn and redeem miles when travelling with SkyTeam member airlines, regardless of the destination or the airline within the alliance. This provides greater variety in travel rewards and more flexible redemption options.\n</p>\n\n<p class=\"saudia-lead-text\">\nBenefits available to Alfursan members when travelling with Saudia’s SkyTeam partner airlines include:\n</p>\n\n<ul class=\"saudia-list--unordered\">\n    <li>Earning miles on flights operated by SkyTeam’s partner airlines.</li>\n    <li>Redeeming earned miles with any SkyTeam member airline.</li>\n</ul>\n\n</div>\n</section>\n<!-- PANEL 3: LOUNGE ACCESS -->\n<section id=\"panel-lounges\" class=\"saudia-tab-panel js-tab-panel\" role=\"tabpanel\" aria-labelledby=\"tab-lounges\">\n<div class=\"saudia-unified-container\">\n<h3 class=\"saudia-h3-spacing\">Access to Airport Lounges Worldwide</h3>\n<p class=\"saudia-lead-text\">\nSaudia offers eligible guests additional options by providing access to selected lounges across the alliance’s global network. This allows guests to enjoy a calm and comfortable environment, along with a variety of services that help make their time before departure more pleasant and relaxing.</p>\n</div>\n</section>\n<!-- PANEL 4: SKYPRIORITY -->\n<section id=\"panel-skypriority\" class=\"saudia-tab-panel js-tab-panel\" role=\"tabpanel\" aria-labelledby=\"tab-skypriority\">\n<div class=\"saudia-unified-container\">\n\n<h3 class=\"saudia-h3-spacing\">SkyTeam Priority Services (SkyPriority)</h3>\n\n<p class=\"saudia-lead-text\">\nEnjoy a seamless airport experience with priority services at every stage of the journey.\n</p>\n\n<p class=\"saudia-lead-text\">\nSkyPriority is a premium airport service offered through the SkyTeam Alliance, providing eligible passengers with priority handling across participating member airlines. The service is available to First Class and Business Class passengers, Alfursan Gold and Silver members, and eligible elite-tier members of SkyTeam member airlines.\n</p>\n\n<p class=\"saudia-lead-text\">\nThe SkyPriority logo appears on boarding passes and airport signage, indicating access to applicable priority services throughout the travel experience.\n</p>\n\n<hr class=\"saudia-section-divider\">\n\n<h4 class=\"saudia-h4-spacing\">SkyPriority touchpoints include:</h4>\n\n<ul class=\"saudia-skypriority-grid\">\n    <li class=\"saudia-skypriority-item\">Priority check-in</li>\n    <li class=\"saudia-skypriority-item\">Priority baggage drop-off</li>\n    <li class=\"saudia-skypriority-item\">Priority security lanes, where available</li>\n    <li class=\"saudia-skypriority-item\">Priority boarding</li>\n    <li class=\"saudia-skypriority-item\">Priority passport control lanes, where available</li>\n    <li class=\"saudia-skypriority-item\">Priority transfer services</li>\n    <li class=\"saudia-skypriority-item\">Priority at sales offices</li>\n    <li class=\"saudia-skypriority-item\">Priority baggage delivery</li>\n</ul>\n\n</div>\n</section>\n<!-- PANEL 5: SEAMLESS CONNECTIONS -->\n<section id=\"panel-connections\" class=\"saudia-tab-panel js-tab-panel\" role=\"tabpanel\" aria-labelledby=\"tab-connections\">\n<div class=\"saudia-unified-container\">\n\n<h3 class=\"saudia-h3-spacing\">Guest Care and Assistance</h3>\n\n<p class=\"saudia-lead-text\">\nTravel across the SkyTeam Alliance network is designed to be more integrated and convenient through:\n</p>\n\n<ul class=\"saudia-list--unordered\">\n    <li>Coordinated flight connections</li>\n    <li>Baggage check-through to the final destination</li>\n    <li>Reduced waiting times during flight transfers</li>\n    <li>Continuous support across SkyTeam member airlines</li>\n    <li>Rebooking and ticketing services provided by alliance member airlines, along with the best available alternatives during operational disruptions</li>\n    <li>Guidance and wayfinding support</li>\n    <li>Providing necessary information and assisting guests through communication and coordination between operating airlines</li>\n    <li>Assistance in case of missed connections</li>\n</ul>\n\n</div>\n</section>\n</main>\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}