nducting comprehensive studies on the airline’s requirements from different aircraft types and sizes,\n      in accordance with Saudia’s operation strategy for domestic, regional and international flights.\n    </p>\n    <div class=\"sa-fleet-stats\">\n      <span>Total Fleet: <strong>149</strong> aircraft</span>\n      <span>Airbus: <strong>95</strong></span>\n      <span>Boeing: <strong>54</strong></span>\n    </div>\n  </div>\n\n  <!-- Airbus Group -->\n  <h3 class=\"aircraft-group-title\">Airbus (95 Aircraft)</h3>\n  <div class=\"aircraft-grid\">\n    <!-- A320 -->\n    <div class=\"aircraft-card\">\n      <a class=\"aircraft-card-link\" href=\"/explore/about-saudia/our-fleet/airbus-a320\" aria-label=\"Airbus A320-214 details\">\n        <div class=\"card-media\">\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Our-fleet/A320.ashx?rev=4548788436cc40998bb05e0a849f58dd&amp;hash=B4E383E7A2801EEA5290BCFDAFD4AF7B\" alt=\"Airbus A320-214 aircraft\">\n          <div class=\"card-overlay\">\n            <h4>Airbus A320-214</h4>\n            <div class=\"overlay-count\">37 aircraft in service</div>\n          </div>\n        </div>\n        <div class=\"card-info\">\n          <h4>Airbus A320-214</h4>\n          <div class=\"count\">37 aircraft</div>\n        </div>\n      </a>\n      <div class=\"card-footer-link\">\n        <a href=\"/explore/about-saudia/our-fleet/airbus-a320\">More</a>\n      </div>\n    </div>\n\n    <!-- A321 -->\n    <div class=\"aircraft-card\">\n      <a class=\"aircraft-card-link\" href=\"/explore/about-saudia/our-fleet/airbus-a321\" aria-label=\"Airbus A321 details\">\n        <div class=\"card-media\">\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Our-fleet/a321neo.ashx?rev=d72d3672759949c5aafe2c57a92559aa&amp;hash=9CCE3D3F58AC5FF996E316A065ACDD25\" alt=\"Airbus A321 aircraft\">\n          <div class=\"card-overlay\">\n            <h4>Airbus A321</h4>\n            <div class=\"overlay-count\">27 aircraft in service</div>\n          </div>\n        </div>\n        <div class=\"card-info\">\n          <h4>Airbus A321</h4>\n          <div class=\"count\">27 aircraft</div>\n        </div>\n      </a>\n      <div class=\"card-footer-link\">\n        <a href=\"/explore/about-saudia/our-fleet/airbus-a321\">More</a>\n      </div>\n    </div>\n\n    <!-- A330-343 -->\n    <div class=\"aircraft-card\">\n      <a class=\"aircraft-card-link\" href=\"/explore/about-saudia/our-fleet/airbus-a330\" aria-label=\"Airbus A330-343 details\">\n        <div class=\"card-media\">\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Our-fleet/A330.ashx?rev=4a73fc8e96804244873f016fd4b131bc&amp;hash=9A7AA2857DA1149FDB70BEF9DEB40C01\" alt=\"Airbus A330-343 aircraft\">\n          <div class=\"card-overlay\">\n            <h4>Airbus A330-343</h4>\n            <div class=\"overlay-count\">31 aircraft in service</div>\n          </div>\n        </div>\n        <div class=\"card-info\">\n          <h4>Airbus A330-343</h4>\n          <div class=\"count\">31 aircraft</div>\n        </div>\n      </a>\n      <div class=\"card-footer-link\">\n        <a href=\"/explore/about-saudia/our-fleet/airbus-a330\">More</a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Boeing Group -->\n  <h3 class=\"aircraft-group-title\">Boeing (54 Aircraft)</h3>\n  <div class=\"aircraft-grid\">\n    <!-- B777-368ER -->\n    <div class=\"aircraft-card\">\n      <a class=\"aircraft-card-link\" href=\"/explore/about-saudia/our-fleet/boeing-b777\" aria-label=\"Boeing B777-368ER details\">\n        <div class=\"card-media\">\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Our-fleet/B777-300.ashx?rev=0ed28fa2caa042f8ba52d338f9bbcb63&amp;hash=4AC06EF8F7FC00A24B121E5D8F2CBCB8\" alt=\"Boeing B777-368ER aircraft\">\n          <div class=\"card-overlay\">\n            <h4>Boeing B777-368ER</h4>\n            <div class=\"overlay-count\">33 aircraft in service</div>\n          </div>\n        </div>\n        <div class=\"card-info\">\n          <h4>Boeing B777-368ER</h4>\n          <div class=\"count\">33 aircraft</div>\n        </div>\n      </a>\n      <div class=\"card-footer-link\">\n        <a href=\"/explore/about-saudia/our-fleet/boeing-b777\">More</a>\n      </div>\n    </div>\n\n    <!-- B787 -->\n    <div class=\"aircraft-card\">\n      <a class=\"aircraft-card-link\" href=\"/explore/about-saudia/our-fleet/boeing-b787\" aria-label=\"Boeing B787 details\">\n        <div class=\"card-media\">\n          <img src=\"/-/media/SaudiaWebApp/data/media/img/Our-fleet/B787-10.ashx?rev=ba93cb2a8ccb44ccb5a420d3ac30cc9d&amp;hash=B0E7CE48AB1C54DBE60026A73A3A7BDB\" alt=\"Boeing B787 aircraft\">\n          <div class=\"card-overlay\">\n            <h4>Boeing B787</h4>\n            <div class=\"overlay-count\">21 aircraft in service</div>\n          </div>\n        </div>\n        <div class=\"card-info\">\n          <h4>Boeing B787</h4>\n          <div class=\"count\">21 aircraft</div>\n        </div>\n      </a>\n      <div class=\"card-footer-link\">\n        <a href=\"/explore/about-saudia/our-fleet/boeing-b787\">More</a>\n      </div>\n    </div>\n  </div>\n\n \n</div>\n</p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-space class=\"ng-star-inserted\"><div class=\"cms-spacer-component\"></div></app-jss-space><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><