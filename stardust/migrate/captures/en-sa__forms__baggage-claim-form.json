{"url":"https://www.saudia.com/en-SA/forms/baggage-claim-form","status":200,"title":"Saudia Baggage Claim Form Submission | Saudia","desc":"Complete your Saudia baggage claim form for missing or damaged luggage. Submit details and start your claim process quickly with Saudia today.","finalUrl":"https://www.saudia.com/en-SA/forms/baggage-claim-form","bodyClass":"white-theme jssform-page form-baggage-claim baseLang withTravelNotice mWebHomePage","h":4003,"sig":[{"tag":"app-jss-columns","comps":["app-jss-image-link-list"],"h":248,"headings":1,"imgs":1,"text":28},{"tag":"app-jss-columns","comps":["app-jss-columns","app-jss-faq"],"h":1143,"headings":1,"imgs":7,"text":5886},{"tag":"app-jss-columns","comps":["app-jss-title-text"],"h":156,"headings":1,"imgs":0,"text":704},{"tag":"app-jss-columns","comps":["app-jss-dynamic-form"],"h":442,"headings":1,"imgs":0,"text":213},{"tag":"app-jss-columns","comps":["app-jss-faq"],"h":635,"headings":1,"imgs":0,"text":1074}],"h1":["Saudia Baggage Claim Form Submission | Saudia","Baggage Claim & Compensation"],"html":"<sc-placeholder _ngcontent-saudiawebapp-c260489156=\"\" name=\"jss-main\"><!----><app-jss-columns><div class=\"flex-container container--horizontal\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-image-link-list class=\"ng-star-inserted\"><div class=\"custom-carousel imagelinklist--content-embedded h--left v--center imagelinklist-icon--rectangle image--slider ng-star-inserted\"><!----><div appswiper=\"\" fxflex=\"auto\" class=\"swiper-container ng-star-inserted swiper-initialized swiper-horizontal swiper-backface-hidden\"><div class=\"swiper-wrapper\"><div class=\"swiper-slide ng-star-inserted swiper-slide-active\"><div fxlayout=\"column\" fxlayoutalign=\"\" fxflexfill=\"\"><div aria-hidden=\"true\" class=\"swiper-slide__image desktop-view ng-star-inserted\"><img fetchpriority=\"high\" alt=\"\" width=\"1920\" height=\"600\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Banner/Baggage-claim-new.ashx?h=600&amp;iar=0&amp;w=1920&amp;rev=f75106af18dd4a259af1616e56b71bb6&amp;hash=0673929C9C507DE11FE07F124F9FF1B9\" class=\"ng-star-inserted\"><!----><div class=\"image-gradient\" id=\"c83a1a6a-6944-4c83-8225-451d4b7773ce\"></div></div><!----><!----><div class=\"container\"><div class=\"swiper-slide__content\"><!----><!----><h1 appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">Baggage Claim &amp; Compensation</span><!----></h1><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div><!----></div></div></div><!----><!----></div></div><!----><div class=\"custom-pagination ng-star-inserted\"><div class=\"container\"><div id=\"cpage_banner\" class=\"custom-pages\"></div></div></div><!----><!----></div><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></app-jss-image-link-list><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-columns class=\"ng-star-inserted\"><div class=\"flex-container\"><div><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row ng-star-inserted\"><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-faq class=\"ng-star-inserted\"><div class=\"faq-section ng-star-inserted\"><div class=\"container\"><div fxlayout=\"row\" fxlayout.lt-lg=\"column\" fxlayoutgap=\"20px grid\" fxlayoutgap.gt-lg=\"24px grid\"><div fxflex.gt-lg=\"50\" class=\"faq__title\"><h2 class=\"primary-heading ng-star-inserted\" aria-label=\"\">Assistance with Mishandled Baggage Claims</h2><!----><!----></div><div fxflex.gt-lg=\"50\"><mat-accordion class=\"mat-accordion faq__accordion\"><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-0 mat-expanded mat-expansion-panel-spacing ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-1 ng-tns-c1859850774-0 ng-animate-disabled mat-expanded mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Reporting Delayed or Lost Baggage\" id=\"mat-expansion-panel-header-0\" aria-controls=\"cdk-accordion-child-0\" aria-expanded=\"true\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-1\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-1\"> Reporting Delayed or Lost Baggage </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-1 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-0 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-0\" aria-labelledby=\"mat-expansion-panel-header-0\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-0\"><p class=\"mat-panel-body-custom ng-star-inserted\"><div><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/Delayed-and-Lost-Baggage?rev=3f9de1a17b174ed19a0d3f9a979c4a39&amp;hash=11D7F48E7FA45E7D3EACE58026BF898A\"></div>\n<div>\n<ul>\n    <li>Report the mishandled baggage to the Baggage Service Counter before leaving the arrival area. Alternatively, You Can Use the Self-Service Option:</li>\n    <li>Fill out the claim form via this link: <a rel=\"noopener noreferrer\" href=\"https://mybag.aero/baggage/#/pax/saudia/en-gb/main-menu\" target=\"_blank\">here</a>. or Scan the QR code and complete the required information. Ensure this is done within 48 hours of flight arrival time to create your claim number, ensuring:\n    <ul>\n        <li>Complete your name with correct spelling, any other name on the bag, permanent and temporary contacts, and any relevant information.</li>\n        <li>The correct type and color of your missing bag through the identification chart provided by the Baggage Services staff.</li>\n        <li>The brand of the baggage, e.g., Samsonite, Delsey, American Tourister, etc.</li>\n    </ul>\n    </li>\n    <li>A report will be issued, and we will work diligently on the Delayed or Lost bag.</li>\n    <li>Use the above claim form link to track your baggage.</li>\n    <li>If traveling to another destination, contact the Baggage Services staff there for further assistance.</li>\n    <li>Unclaimed items will be transferred to the Central Baggage Warehouse.</li>\n    <li>If your baggage is not located within 10 days, submit a claim by completing the Baggage Compensation  Form after (11) days of the Delay Report.</li>\n    <li>If you're unable to retrieve your item within this timeframe, please emaill&nbsp;<a href=\"mailto:baggage.inquiries@saudia.com\">baggage.inquiries@saudia.com</a>\n    with your flight details, along with a description of the item, including its brand and color.</li>\n    <li>Please note, Saudia is not liable for loss personal items.</li>\n</ul>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-2 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-3 ng-tns-c1859850774-2 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Reporting Damaged Baggage\" id=\"mat-expansion-panel-header-1\" aria-controls=\"cdk-accordion-child-1\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-3\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-3\"> Reporting Damaged Baggage </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-3 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-2 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-1\" aria-labelledby=\"mat-expansion-panel-header-1\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-2\"><p class=\"mat-panel-body-custom ng-star-inserted\"><div><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/Damaged-Baggage?rev=d43e57c26e4a4a9e8d3694c1eb6b9f40&amp;hash=117C355D3B756C6EA53CEC66D14AC689\"></div>\n<div>\n<ul>\n    <li>Report damaged baggage to the Baggage Service Counter before leaving the arrival area. An employee will assess the damage and create a damage file. Alternatively, You Can Use the Self-Service Option:</li>\n</ul>\n<ul>\n    <li>Fill out the claim form via this link:\n    <a rel=\"noopener noreferrer\" href=\"https://mybag.aero/baggage/#/pax/saudia/en-gb/main-menu\" target=\"_blank\">here</a>.\n    or Scan the QR code and complete the required information. Ensure this is done within 48 hours of flight arrival time to create your claim number and include the following:\n    <ul>\n        <li>Your full name (with correct spelling), any other name on the bag, permanent and temporary contact information, and any other relevant details.</li>\n        <li>The brand of the baggage (e.g., Samsonite, Delsey, American Tourister, etc.).</li>\n    </ul>\n    </li>\n    <li>If available, an alternative bag will be provided. If not, submit a compensation request by completing the <a href=\"/en-SA/forms/baggage-claim-form\">Baggage Compensation Form</a>&nbsp;after (7) days of the Damage Report.</li>\n</ul>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-4 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-5 ng-tns-c1859850774-4 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Saudia Baggage Liability Policy\" id=\"mat-expansion-panel-header-2\" aria-controls=\"cdk-accordion-child-2\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-5\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-5\"> Saudia Baggage Liability Policy </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-5 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-4 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-2\" aria-labelledby=\"mat-expansion-panel-header-2\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-4\"><p class=\"mat-panel-body-custom ng-star-inserted\"><div><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/Saudias-liability?rev=77715816c1e6455ba7a58c3704a93f74&amp;hash=7B1942FA368CDBBA9FDA5D6CE6D4E273\"></div>\n<div>\n<p>Saudia’s liability is limited to SDR 1,519 unless a higher value was declared and additional fees were paid during check-in. Saudia is not liable for:</p>\n<ul>\n    <li>Damage to unchecked (carry-on) baggage unless caused by Saudia’s negligence.</li>\n    <li>Pre-existing defects, poor quality of the baggage, or minor scratches.</li>\n    <li>Personal items left behind by guests.</li>\n    <li>Bag tagged with Limited Release Tag (LRT)</li>\n    <li>Bag delayed due to prohibited items.</li>\n</ul>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-6 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-7 ng-tns-c1859850774-6 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Baggage Compensation &amp; Reimbursement Guidelines\" id=\"mat-expansion-panel-header-3\" aria-controls=\"cdk-accordion-child-3\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-7\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-7\"> Baggage Compensation &amp; Reimbursement Guidelines </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-7 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-6 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-3\" aria-labelledby=\"mat-expansion-panel-header-3\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-6\"><p class=\"mat-panel-body-custom ng-star-inserted\"><div><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/Compensation-for-Damaged-Baggage?rev=0021399492214f8aa73e3850e374a3a4&amp;hash=36194F751771038C498EC484F07240F9\"></div>\n<div>\n<ul>\n    <li><strong>Total Damage</strong>\n    <ul>\n        <li>Compensation is based on the purchase receipt, actual market value, or a similar brand.\n        </li>\n    </ul>\n    </li>\n    <li><strong>Major Damage</strong>\n    <ul>\n        <li>Saudia will provide a replacement bag or offer negotiated compensation.</li>\n    </ul>\n    </li>\n</ul>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-8 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-9 ng-tns-c1859850774-8 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Important Baggage Claim Information\" id=\"mat-expansion-panel-header-4\" aria-controls=\"cdk-accordion-child-4\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-9\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-9\"> Important Baggage Claim Information </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-9 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-8 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-4\" aria-labelledby=\"mat-expansion-panel-header-4\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-8\"><p class=\"mat-panel-body-custom ng-star-inserted\"><div><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/Important-Notes?rev=a643b19125cd411fbeb40cc31d96e8b3&amp;hash=6B2E855C1392786988BE350C2B15D8F3\"></div>\n<div>\n<ul>\n    <li>If it happens that your baggage is not traced and you need to travel to another destination, you may contact our Baggage Services staff at that point for further handling and information that you may need.</li>\n    <li>Please make sure that you have the Saudia Baggage Services contact information, compensation file references, and documents for further queries.</li>\n    <li>In case of loss of baggage contents, Saudia is not liable for compensation.</li>\n</ul>\n<p><img alt=\"\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/mishandled-baggage-contact.ashx?rev=d5b01db9121d4984bb75a4a0d210191d&amp;hash=2C1B25EA2C79B6B919A1A6FF82EB78DF\"></p>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><mat-expansion-panel class=\"mat-expansion-panel ng-tns-c1859850774-10 ng-star-inserted\"><mat-expansion-panel-header role=\"button\" tabindex=\"0\" class=\"mat-expansion-panel-header mat-focus-indicator un-panel-class ng-tns-c2690051721-11 ng-tns-c1859850774-10 ng-animate-disabled mat-expansion-toggle-indicator-after ng-star-inserted\" aria-label=\"Baggage Claim Self-Service (QR Code / Link)\" id=\"mat-expansion-panel-header-5\" aria-controls=\"cdk-accordion-child-5\" aria-expanded=\"false\" aria-disabled=\"false\"><span class=\"mat-content ng-tns-c2690051721-11\"><mat-panel-title id=\"expPanel\" class=\"mat-expansion-panel-header-title ng-tns-c2690051721-11\"> Baggage Claim Self-Service (QR Code / Link) </mat-panel-title></span><span class=\"mat-expansion-indicator ng-tns-c2690051721-11 ng-trigger ng-trigger-indicatorRotate ng-star-inserted\"></span><!----></mat-expansion-panel-header><div role=\"region\" class=\"mat-expansion-panel-content ng-tns-c1859850774-10 ng-trigger ng-trigger-bodyExpansion\" id=\"cdk-accordion-child-5\" aria-labelledby=\"mat-expansion-panel-header-5\"><div class=\"mat-expansion-panel-body ng-tns-c1859850774-10\"><p class=\"mat-panel-body-custom ng-star-inserted\">\n\n<div class=\"saudia-baggage-wrapper\">\n  <div class=\"saudia-baggage-text\">\n    <p>You may also report mishandled baggage by scanning the QR Code or using the following link.</p>\n    <p>Please complete the form within 48 hours to generate your claim number and track your baggage status.</p>\n\n    <a href=\"https://mybag.aero/baggage/#/pax/saudia/en-gb/main-menu\" class=\"saudia-btn\" role=\"button\">\n      <span class=\"btn-label\">Continue</span>\n      <span aria-hidden=\"true\" class=\"material-symbols-outlined\">arrow_forward</span>\n    </a>\n  </div>\n\n  <div class=\"saudia-baggage-visual\">\n    <img alt=\"Scan QR code to report baggage\" src=\"/-/media/SaudiaWebApp/data/media/img/Sitecore-Forms/Baggage/MishandledBaggage/QR-Code.ashx?rev=5093a8f87f2d4c798b50b38a1155bfc9&amp;hash=FF6ED9976DF3995BE816B90630505B52\" width=\"330\" height=\"327\">\n  </div>\n</div></p><!----><!----></div></div></mat-expansion-panel><!----><!----></mat-accordion></div></div></div></div><!----></app-jss-faq><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\">\n\n<div class=\"saudia-center-wrapper\">\n  <h2 class=\"saudia-form-title\">Baggage Compensation Form</h2>\n  <p>Please complete the form below to start your claim.</p>\n  <hr class=\"saudia-hr\">\n</div></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container-fluid\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-dynamic-form class=\"ng-star-inserted\"><div class=\"form-page ng-star-inserted\"><div class=\"ng-star-inserted