custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-tabs class=\"ng-star-inserted\"><div class=\"cms-tab-container\"><mat-tab-group animationduration=\"0ms\" class=\"mat-tab-group mat-primary ng-star-inserted\"><mat-tab-header class=\"mat-tab-header\"><button aria-hidden=\"false\" type=\"button\" mat-ripple=\"\" tabindex=\"0\" class=\"mat-ripple mat-tab-header-pagination mat-tab-header-pagination-before mat-elevation-z4 mat-tab-header-pagination-disabled\" disabled=\"\" role=\"button\" aria-label=\"Previous slide\"><div class=\"mat-tab-header-pagination-chevron\"></div></button><div class=\"mat-tab-label-container\"><div role=\"tablist\" class=\"mat-tab-list\"><div class=\"mat-tab-labels\"><div role=\"tab\" mattablabelwrapper=\"\" mat-ripple=\"\" cdkmonitorelementfocus=\"\" class=\"mat-ripple mat-tab-label mat-focus-indicator mat-tab-label-active ng-star-inserted\" id=\"mat-tab-label-0-0\" tabindex=\"0\" aria-posinset=\"1\" aria-setsize=\"3\" aria-controls=\"mat-tab-content-0-0\" aria-selected=\"true\" aria-disabled=\"false\"><div class=\"mat-tab-label-content\">Medical form<!----><!----><!----></div></div><div role=\"tab\" mattablabelwrapper=\"\" mat-ripple=\"\" cdkmonitorelementfocus=\"\" class=\"mat-ripple mat-tab-label mat-focus-indicator ng-star-inserted\" id=\"mat-tab-label-0-1\" tabindex=\"-1\" aria-posinset=\"2\" aria-setsize=\"3\" aria-controls=\"mat-tab-content-0-1\" aria-selected=\"false\" aria-disabled=\"false\"><div class=\"mat-tab-label-content\">Pregnancy form<!----><!----><!----></div></div><div role=\"tab\" mattablabelwrapper=\"\" mat-ripple=\"\" cdkmonitorelementfocus=\"\" class=\"mat-ripple mat-tab-label mat-focus-indicator ng-star-inserted\" id=\"mat-tab-label-0-2\" tabindex=\"-1\" aria-posinset=\"3\" aria-setsize=\"3\" aria-controls=\"mat-tab-content-0-2\" aria-selected=\"false\" aria-disabled=\"false\"><div class=\"mat-tab-label-content\">Medical Devices<!----><!----><!----></div></div><!----></div><mat-ink-bar class=\"mat-ink-bar\"></mat-ink-bar></div></div><button aria-hidden=\"false\" type=\"button\" mat-ripple=\"\" tabindex=\"0\" class=\"mat-ripple mat-tab-header-pagination mat-tab-header-pagination-after mat-elevation-z4 mat-tab-header-pagination-disabled\" disabled=\"\" role=\"button\" aria-label=\"Next slide\"><div class=\"mat-tab-header-pagination-chevron\"></div></button></mat-tab-header><div class=\"mat-tab-body-wrapper\"><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-26 mat-tab-body-active ng-star-inserted\" id=\"mat-tab-content-0-0\" aria-labelledby=\"mat-tab-label-0-0\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-26 ng-trigger ng-trigger-translateTab\"><!----><div class=\"ng-star-inserted\"><p appexcerpttext=\"\" class=\"ng-star-inserted\"><span class=\"ng-star-inserted\">\n<div id=\"medical-form-main\" class=\"collapse-body collapse show medical-section\" aria-labelledby=\"medical-form-main\" data-parent=\".accordion\">\n<h2 class=\"fs-1-5 vg-0--top\">Medical Certificates (MEDIF)</h2>\n<p>\nIf you need medical assistance (such as a stretcher or oxygen kit) onboard Saudia flights, kindly provide the following:\n</p>\n<ol>\n    <li>\n    Complete our MEDIF form\n    (<a class=\"exclude-external-link\" href=\"/-/media/SaudiaWebApp/data/media/files/MEDIF.ashx?rev=-1&amp;hash=A200E5C9836A786FC56FF73136DD2242\" target=\"_blank\">here</a>)\n    and ensure that all sections are filled in, preferably on a computer.\n    </li>\n    <li>\n    Include both the doctor’s and the hospital’s stamps and specify the validity period of the MEDIF form (10, 30, or 90 days).\n    </li>\n    <li>\n    Send it via email to:\n    <a href=\"mailto:meda@saudia.com\">meda@saudia.com</a>\n    </li>\n    <li>\n    Provide booking details for both the patient and the escort (if applicable).\n    </li>\n    <li>\n    Submit medical requests at least three days before departure for domestic flights and seven days before departure for international flights.\n    </li>\n    <li>\n    If a booking has not yet been made, kindly send us the IDs or passports for both the patient and escort so that we can create the bookings and submit the medical request.\n    </li>\n    <li>\n    If the patient requires a stretcher or continuous oxygen, an ambulance must be arranged at the arrival station to make the arrival process easier and more comfortable for the patient.\n    </li>\n    <li>\n    Please review the terms and conditions for carrying a portable medical device onboard.\n    </li>\n    <li>\n    For further assistance, you may contact us at +966126868540.\n    </li>\n</ol>\n<h3 class=\"fs-1-3 vg-0--top\">These conditions include:</h3>\n<ul>\n    <li>Having a communicable disease or infection.</li>\n    <li>\n    Having a medical condition that raises reasonable doubt that the guest can complete the flight safely without requiring extraordinary medical assistance during the flight.\n    </li>\n    <li>\n    The guest’s condition may cause discomfort to other guests due to their physical or behavioral status.\n    </li>\n    <li>\n    The guest’s condition may cause delays or disruptions to the flight schedule, including the possibility of route changes or an emergency landing.\n    </li>\n    <li>\n    The guest cannot rely on themselves and requires full assistance during the flight.\n    </li>\n    <li>\n    The guest needs special medical attention and/or special devices to maintain their health during the flight.\n    </li>\n</ul>\n<p>\nYou may download the Standard Medical Information Form for Air Travel (MEDIF)\n<a class=\"exclude-external-link\" href=\"/-/media/SaudiaWebApp/data/media/files/MEDIF.ashx?rev=-1&amp;hash=A200E5C9836A786FC56FF73136DD2242\" target=\"_blank\">by clicking here</a>.\n</p>\n<p>\n<strong>Note:</strong> As part of preventive measures to limit the transmission of Ebola, the Directorate General of Lebanese Civil Aviation has\nannounced that all carriers are required to complete the attached medical form for guests traveling from Congo and Uganda to RHI Airport, and to\nsubmit it to the Quarantine Service at RHI.\n<a rel=\"noopener noreferrer\" href=\"/-/media/SaudiaWebApp/data/media/files/45-8.ashx?rev=-1&amp;hash=95EC6644182CCF6E487E4548DC4D65FD\" target=\"_blank\">Please click here</a>\nto complete the medical form for guests traveling from Congo and Uganda.\n</p>\n<h3 class=\"fs-1-3 vg-0--top\">Guests with Renal Failure</h3>\n<p>\nSaudia provides additional\n<a href=\"/en-SA/manage/baggage/baggage-info\">baggage allowance</a>&nbsp;    free of charge for medicines and medical equipment, in addition to the standard free baggage allowance based on the travel class. The guest must\npresent a medical certificate from the hospital confirming that they are a renal failure patient.\n</p>\n</div></span><!----></p><!----></div><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-27 ng-star-inserted\" id=\"mat-tab-content-0-1\" aria-labelledby=\"mat-tab-label-0-1\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-27 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><mat-tab-body role=\"tabpanel\" class=\"mat-tab-body ng-tns-c3106391717-28 ng-star-inserted\" id=\"mat-tab-content-0-2\" aria-labelledby=\"mat-tab-label-0-2\"><div cdkscrollable=\"\" class=\"mat-tab-body-content ng-tns-c3106391717-28 ng-trigger ng-trigger-translateTab\"><!----></div></mat-tab-body><!----></div></mat-tab-group><!----></div></app-jss-tabs><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><app-jss-title-text class=\"ng-star-inserted\"><!----><div class=\"title-text isCashMilesInView ng-star-inserted\"><!----><!----><!----><p appexcerpttext=\"\" class=\"titleTextSub ng-star-inserted\"><p>For further assistance, feel free to contact us at +966126868540.</p></p><!----><!----><!----><!----></div><!----><!----></app-jss-title-text><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><app-jss-columns><div class=\"flex-container\"><div class=\"container\"><!----><!----><div fxlayout=\"row\" fxlayout.xs=\"column\" fxlayoutalign=\"flex-start\" class=\"custom-row\"><div class=\"flex-col\"><sc-placeholder fxlayout=\"row\" class=\"flex-placeholder\"><!----><!----></sc-placeholder></div><!----><!----></div><!----><!----></div></div><!----><!----></app-jss-columns><!----></sc-placeholder>"}